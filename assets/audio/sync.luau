local definitions = {
{path="ReplicatedStorage/Shared/Abilities/VFX/AstralVFX",class="ModuleScript",source="local ImportedAudio = require(game:GetService(\"ReplicatedStorage\").Shared.Audio.DownloadedSounds)\n-- Astral Verdict, drawn from one message:\n--   chart    stars pop into the sky over the aim one by one and are joined\n--            into a constellation in the shape of a sword, while a star seal\n--            draws itself on the ground below\n--   forge    the constellation fades into a blade of starlight\n--   verdict  the blade turns point-down, rises, and drops into the seal: a\n--            star burst, a galaxy on the ground, impact frames, a shake and\n--            a punch\n--   shatter  after a moment the blade breaks into stars that arc out and\n--            rain down round the seal\n-- Every visible effect is an authored particle, Beam or Trail; Parts are\n-- invisible emitter hosts only.\nlocal Plan = require(script.Parent.Parent.AstralPlan)\nlocal Kit = require(script.Parent.AbilityKit)\nlocal ImpactFX = require(script.Parent.ImpactFX)\nlocal Library = require(script.Parent.AstralParticles)\n\nlocal VFX = {}\nlocal T = Plan.Tuning\nlocal STAR = Color3.fromRGB(245, 245, 255)\nlocal ASTRAL = Color3.fromRGB(150, 175, 255)\nlocal VIOLET = Color3.fromRGB(165, 110, 255)\nlocal NIGHT = Color3.fromRGB(25, 18, 60)\nlocal ns, curve, colors = Kit.ns, Kit.curve, Kit.colors\nlocal live = 0\nlocal preloaded = false\n\nlocal Sheets = {\n\t-- Slash VFX Trail2: a soft-edged band, for glows and the seal's strokes.\n\tBand = {Texture = \"rbxassetid://16892374733\"},\n}\n\nlocal SOUND_CHIME = ImportedAudio.ability_magic_glow\nlocal SOUND_SWISH = ImportedAudio.ability_whoosh\nlocal SOUND_BOOM = ImportedAudio.ability_impact_heavy\nlocal SOUND_HIT = \"rbxasset://sounds/hit.wav\"\n\nfunction VFX.preload()\n\tif preloaded then return end\n\tpreloaded = true\n\tKit.preload(Kit.textures(Library, Sheets), {SOUND_CHIME, SOUND_SWISH, SOUND_BOOM, SOUND_HIT})\nend\n\nfunction VFX.duration()\n\treturn Plan.duration()\nend\n\nlocal function emitter(kind, parent, props)\n\treturn Kit.emitter(if Sheets[kind] then Sheets else Library, kind, parent, props)\nend\n\n-- A stroke lying flat in its host's XZ plane. A beam bends along its\n-- attachments' X axes and spreads its width along their Y axes, so Y points\n-- across the stroke on the ground.\nlocal function stroke(host, width, color, emission, z, texture)\n\tlocal a0, a1 = Kit.attachment(host), Kit.attachment(host)\n\tlocal beam = Kit.beam(host, a0, a1, {\n\t\tTexture = texture or Sheets.Band.Texture, TextureMode = Enum.TextureMode.Stretch, TextureLength = 1, FaceCamera = false,\n\t\tSegments = 12, Width0 = width, Width1 = width, Color = ColorSequence.new(color), LightEmission = emission,\n\t\tBrightness = if emission > 0.5 then 2 else 1, Transparency = ns(1), Enabled = false, ZOffset = z or 0,\n\t})\n\treturn {beam = beam, a0 = a0, a1 = a1, width = width}\nend\n\nlocal function radial(theta)\n\treturn Vector3.new(math.cos(theta), 0, math.sin(theta))\nend\n\n-- A whole circle in four quarter arcs; a cubic quarter arc is circular when\n-- its control points sit 0.5523 of the radius along each end's tangent.\nlocal function circle(host, width, color, emission, z, texture)\n\tlocal arcs = {}\n\tfor q = 1, 4 do arcs[q] = stroke(host, width, color, emission, z, texture) end\n\treturn arcs\nend\n\nlocal function layoutCircle(arcs, radius, opacity, widthScale)\n\tfor q, s in ipairs(arcs) do\n\t\tlocal t0, t1 = (q - 1) * math.pi / 2, q * math.pi / 2\n\t\ts.a0.CFrame = CFrame.fromMatrix(radial(t0) * radius, radial(t0 + math.pi / 2), radial(t0))\n\t\ts.a1.CFrame = CFrame.fromMatrix(radial(t1) * radius, radial(t1 + math.pi / 2), radial(t1))\n\t\ts.beam.CurveSize0, s.beam.CurveSize1 = radius * 0.5523, radius * 0.5523\n\t\tlocal width = s.width * (widthScale or 1)\n\t\ts.beam.Width0, s.beam.Width1 = width, width\n\t\tKit.opacity(s.beam, if radius > 0.1 then opacity else 0)\n\tend\nend\n\nlocal function layoutLine(s, from, to, opacity)\n\tlocal along = to - from\n\tif along.Magnitude < 0.05 then\n\t\tKit.opacity(s.beam, 0)\n\t\treturn\n\tend\n\tlocal across = Vector3.yAxis:Cross(along).Unit\n\ts.a0.CFrame = CFrame.fromMatrix(from, along.Unit, across)\n\ts.a1.CFrame = CFrame.fromMatrix(to, along.Unit, across)\n\tKit.opacity(s.beam, opacity)\nend\n\nlocal function outward(t)\n\tt = math.clamp(t, 0, 1)\n\treturn 1 - (1 - t) ^ 3\nend\n\n-- A beam between two attachments the update loop places in the world.\nlocal function span(host, a0, a1, props)\n\tlocal all = {TextureMode = Enum.TextureMode.Stretch, TextureLength = 1, FaceCamera = true, Segments = 1, Enabled = false}\n\tfor key, value in pairs(props) do all[key] = value end\n\treturn Kit.beam(host, a0, a1, all)\nend\n\nfunction VFX.play(payload, scope)\n\tif typeof(payload.origin) ~= \"CFrame\" or typeof(payload.centre) ~= \"Vector3\" or typeof(payload.normal) ~= \"Vector3\"\n\t\tor type(payload.startedAt) ~= \"number\" or type(payload.seed) ~= \"number\" then\n\t\treturn false\n\tend\n\tlocal total = Plan.duration()\n\tif workspace:GetServerTimeNow() - payload.startedAt >= total or live >= 3 then return false end\n\tlive += 1\n\tscope:add(function() live -= 1 end)\n\tVFX.preload()\n\n\tlocal origin, centre, normal = payload.origin, payload.centre, payload.normal\n\tlocal up = Vector3.yAxis\n\tlocal look, side = Plan.frame(origin)\n\tlocal middle = centre + up * T.Height\n\tlocal L = T.Length\n\tlocal turnAt, dropAt, impactAt, shatterAt, rainAt = Plan.turnAt(), Plan.dropAt(), Plan.impactAt(), Plan.shatterAt(), Plan.rainAt()\n\tlocal folder = scope:add(Instance.new(\"Folder\"))\n\tfolder.Name = \"AstralVerdict\"\n\tfolder.Parent = workspace\n\n\t-- The raised hand ----------------------------------------------------------------\n\tlocal caster = payload.caster\n\tlocal character = caster and caster.Character\n\tlocal hand = character and (character:FindFirstChild(\"RightHand\") or character:FindFirstChild(\"Right Arm\"))\n\tlocal handPoint = if hand then hand.Position else (origin * CFrame.new(1.2, 1, -0.6)).Position\n\tlocal handHost = Kit.host(folder, \"Hand\", CFrame.new(handPoint))\n\tlocal handAt = Kit.attachment(handHost, CFrame.new(handPoint))\n\tlocal call = {\n\t\t{emitter(\"StarFlare\", handAt, {Color = ColorSequence.new(STAR), Size = curve({0, 6}, {1, 0}), Lifetime = NumberRange.new(0.3)}), 1},\n\t\t{emitter(\"Sparkle\", handAt, {Color = colors(STAR, ASTRAL), Size = ns(5), Lifetime = NumberRange.new(0.6), LightEmission = 1}), 1},\n\t\t{emitter(\"SlashStar\", handAt, {Color = colors(STAR, VIOLET), Speed = NumberRange.new(40, 70)}), 6},\n\t}\n\n\t-- The constellation ------------------------------------------------------------------\n\tlocal skyHost = Kit.host(folder, \"Sky\", CFrame.new(middle))\n\tlocal stars = Plan.stars(payload.seed, middle, side)\n\tlocal appear = {}\n\tlocal points, pops, twinkles = {}, {}, {}\n\tfor i, star in ipairs(stars) do\n\t\tappear[i] = 0.05 + (i - 1) * 0.07\n\t\tlocal at = Kit.attachment(skyHost, CFrame.new(star))\n\t\tpoints[i] = at\n\t\tpops[i] = {\n\t\t\t{emitter(\"StarFlare\", at, {Color = ColorSequence.new(STAR), Size = curve({0, 8}, {1, 0}), Lifetime = NumberRange.new(0.35)}), 1},\n\t\t\t{emitter(\"Sparkle\", at, {Color = colors(STAR, ASTRAL), Size = ns(6), Lifetime = NumberRange.new(0.6), LightEmission = 1}), 1},\n\t\t}\n\t\ttwinkles[i] = {\n\t\t\temitter(\"Twinkle\", at, {Color = colors(ASTRAL, VIOLET), Size = ns(if i == 7 or i == 1 then 4.5 else 3.5), Lifetime = NumberRange.new(0.6),\n\t\t\t\tLightEmission = 0.5, Rotation = NumberRange.new(0, 90), Rate = 3, LockedToPart = true}),\n\t\t\temitter(\"StarLight\", at, {Color = ColorSequence.new(VIOLET), Size = ns(5), Rate = 3, Brightness = 2}),\n\t\t}\n\tend\n\tlocal links = {}\n\tfor i, link in ipairs(Plan.links) do\n\t\tlocal a0, a1 = Kit.attachment(skyHost), Kit.attachment(skyHost)\n\t\tlinks[i] = {\n\t\t\ta0 = a0, a1 = a1, from = link[1], to = link[2],\n\t\t\tstart = math.max(appear[link[1]], appear[link[2]]) + 0.04,\n\t\t\t-- Alpha-blended blue so the lines hold up against a daytime sky.\n\t\t\tbeams = {\n\t\t\t\tspan(skyHost, a0, a1, {Texture = \"\", Color = ColorSequence.new(Color3.fromRGB(110, 120, 240)), LightEmission = 0.3,\n\t\t\t\t\tWidth0 = 0.35, Width1 = 0.35, ZOffset = 0.1}),\n\t\t\t\tspan(skyHost, a0, a1, {Texture = Sheets.Band.Texture, Color = ColorSequence.new(VIOLET), LightEmission = 0.3, Brightness = 1.5,\n\t\t\t\t\tWidth0 = 1.8, Width1 = 1.8}),\n\t\t\t},\n\t\t}\n\tend\n\n\t-- The blade ------------------------------------------------------------------------\n\tlocal swordHost = Kit.host(folder, \"Sword\", CFrame.new(middle))\n\tlocal hilt, tip = Kit.attachment(swordHost), Kit.attachment(swordHost)\n\tlocal guardL, guardR, pommel = Kit.attachment(swordHost), Kit.attachment(swordHost), Kit.attachment(swordHost)\n\t-- A solid astral-blue blade in a violet aura, with a white-hot edge down\n\t-- the middle. Additive layers bleach on a daytime sky, so the body is\n\t-- alpha-blended and only the edge glows.\n\tlocal blade = {\n\t\t{beam = span(swordHost, hilt, tip, {Texture = Library.Streak.Texture, Color = colors(VIOLET, ASTRAL), LightEmission = 0.4, Brightness = 1.5,\n\t\t\tTransparency = curve({0, 0.35}, {1, 0.65})}), w0 = 7.5, w1 = 1.6},\n\t\t{beam = span(swordHost, hilt, tip, {Texture = \"\", Color = colors(Color3.fromRGB(110, 120, 240), ASTRAL), LightEmission = 0.15, ZOffset = 0.1}),\n\t\t\tw0 = 3, w1 = 0.15},\n\t\t{beam = span(swordHost, hilt, tip, {Texture = Library.Spike.Texture, Color = ColorSequence.new(ASTRAL), LightEmission = 1, Brightness = 1.5,\n\t\t\tZOffset = 0.15}), w0 = 2.6, w1 = 0.4},\n\t\t{beam = span(swordHost, hilt, tip, {Texture = \"\", Color = ColorSequence.new(STAR), LightEmission = 1, ZOffset = 0.2}), w0 = 0.45, w1 = 0.03},\n\t}\n\tlocal fittings = {\n\t\tspan(swordHost, guardL, guardR, {Texture = \"\", Color = ColorSequence.new(Color3.fromRGB(110, 120, 240)), LightEmission = 0.15,\n\t\t\tWidth0 = 1.1, Width1 = 1.1, ZOffset = 0.1}),\n\t\tspan(swordHost, guardL, guardR, {Texture = Sheets.Band.Texture, Color = ColorSequence.new(VIOLET), LightEmission = 0.5, Brightness = 1.5,\n\t\t\tWidth0 = 3, Width1 = 3}),\n\t\tspan(swordHost, hilt, pommel, {Texture = \"\", Color = ColorSequence.new(Color3.fromRGB(80, 70, 160)), LightEmission = 0.3,\n\t\t\tWidth0 = 0.8, Width1 = 0.7, ZOffset = 0.05}),\n\t}\n\tlocal gleam = {\n\t\temitter(\"Orb\", pommel, {Color = colors(STAR, VIOLET), Size = ns(2.4), Lifetime = NumberRange.new(0.5), LightEmission = 1, Rate = 6,\n\t\t\tLockedToPart = true}),\n\t\temitter(\"StarFlare\", hilt, {Color = ColorSequence.new(STAR), Size = curve({0, 3.5}, {1, 1}), Lifetime = NumberRange.new(0.3), Rate = 8,\n\t\t\tLockedToPart = true}),\n\t}\n\tlocal sparkles = {}\n\tfor i = 1, 3 do\n\t\tlocal at = Kit.attachment(swordHost)\n\t\tsparkles[i] = {at = at, along = i / 4, emitter = emitter(\"Twinkle\", at, {Color = colors(STAR, ASTRAL), Size = ns(2.6),\n\t\t\tLifetime = NumberRange.new(0.5), LightEmission = 1, Rate = 4, Rotation = NumberRange.new(0, 90)})}\n\tend\n\tlocal smear = Kit.trail(swordHost, hilt, tip, {Texture = Library.Streak.Texture, Color = colors(STAR, VIOLET), LightEmission = 1,\n\t\tBrightness = 2, FaceCamera = true, Lifetime = 0.18, Transparency = curve({0, 0.2}, {1, 1}), Enabled = false})\n\tlocal tipAt = Kit.attachment(swordHost)\n\tlocal streaks = emitter(\"Lines\", tipAt, {Color = colors(STAR, VIOLET), Speed = NumberRange.new(60, 100), EmissionDirection = Enum.NormalId.Top,\n\t\tSpreadAngle = Vector2.new(8, 8), Rate = 60, LockedToPart = false})\n\tlocal forge = {\n\t\t{emitter(\"StarFlare\", hilt, {Color = ColorSequence.new(STAR), Size = curve({0, 10}, {1, 0}), Lifetime = NumberRange.new(0.3)}), 1},\n\t\t{emitter(\"Sparkle\", hilt, {Color = colors(ASTRAL, VIOLET), Size = ns(8), Lifetime = NumberRange.new(0.6), LightEmission = 0.6}), 2},\n\t}\n\tlocal swordLight = Kit.light(swordHost, ASTRAL, 30)\n\n\t-- The seal --------------------------------------------------------------------------\n\tlocal sideFlat = normal:Cross(Vector3.zAxis)\n\tsideFlat = if sideFlat.Magnitude > 0.1 then sideFlat.Unit else Vector3.xAxis\n\tlocal sealFrame = CFrame.fromMatrix(centre + normal * 0.2, sideFlat, normal)\n\tlocal sealHost = Kit.host(folder, \"Seal\", sealFrame)\n\tlocal R = T.SealRadius\n\tlocal shade = circle(sealHost, R, NIGHT, 0, -0.1, \"\")\n\tlocal rim = circle(sealHost, 1, ASTRAL, 0.6, 0.1)\n\tlocal rimGlow = circle(sealHost, 3.5, VIOLET, 1, 0)\n\tlocal inner = circle(sealHost, 0.6, STAR, 0.8, 0.1)\n\tlocal octagram = {}\n\tfor i = 1, 8 do octagram[i] = stroke(sealHost, 0.5, STAR, 0.8, 0.1) end\n\tlocal octaGlow = {}\n\tfor i = 1, 8 do octaGlow[i] = stroke(sealHost, 2, VIOLET, 1, 0) end\n\tlocal sealLight = Kit.light(sealHost, ASTRAL, 26)\n\n\t-- The impact ------------------------------------------------------------------------\n\tlocal blastAt = Kit.attachment(sealHost, CFrame.new(centre + normal * 2))\n\tlocal groundAt = Kit.attachment(sealHost, CFrame.new(centre + normal * 0.6))\n\tlocal impact = {\n\t\t-- One white flash; the rest stays blue and violet so the layers do not\n\t\t-- bleach each other out.\n\t\t{emitter(\"StarFlare\", blastAt, {Color = ColorSequence.new(STAR), Size = curve({0, 26}, {1, 0}), Lifetime = NumberRange.new(0.25)}), 1},\n\t\t{emitter(\"StarBurst\", blastAt, {Color = colors(ASTRAL, VIOLET), Size = ns(22), Lifetime = NumberRange.new(0.45), LightEmission = 0.4}), 1},\n\t\t{emitter(\"HitFlash\", blastAt, {Color = ColorSequence.new(ASTRAL), Size = curve({0, 12}, {1, 0}), Lifetime = NumberRange.new(0.15)}), 1},\n\t\t{emitter(\"HitRing\", blastAt, {Color = ColorSequence.new(VIOLET), Size = curve({0, 4}, {0.5, 24}, {1, 30}), Lifetime = NumberRange.new(0.35),\n\t\t\tBrightness = 1, LightEmission = 0.5}), 1},\n\t\t{emitter(\"HitLines\", blastAt, {Color = ColorSequence.new(STAR), Speed = NumberRange.new(80, 140), Size = curve({0, 6, 1}, {1, 0}),\n\t\t\tLockedToPart = false}), 16},\n\t\t{emitter(\"Lines\", blastAt, {Color = colors(STAR, VIOLET), Speed = NumberRange.new(70, 120), EmissionDirection = Enum.NormalId.Top,\n\t\t\tSpreadAngle = Vector2.new(60, 60)}), 14},\n\t\t{emitter(\"Sparks\", blastAt, {Color = colors(ASTRAL, VIOLET), Speed = NumberRange.new(60, 110), EmissionDirection = Enum.NormalId.Top,\n\t\t\tSpreadAngle = Vector2.new(70, 70), Lifetime = NumberRange.new(0.4, 0.7)}), 30},\n\t\t{emitter(\"SlashStar\", blastAt, {Color = colors(STAR, VIOLET)}), 12},\n\t\t{emitter(\"Galaxy\", groundAt, {Color = colors(ASTRAL, VIOLET), Size = ns(24), Lifetime = NumberRange.new(1.1), LightEmission = 0.4,\n\t\t\tRotation = NumberRange.new(0, 360)}), 1},\n\t\t{emitter(\"Smoke\", groundAt, {Color = ColorSequence.new(NIGHT), Size = curve({0, 0}, {0.15, 6, 1}, {1, 8}), Speed = NumberRange.new(25, 50),\n\t\t\tEmissionDirection = Enum.NormalId.Top, SpreadAngle = Vector2.new(90, 20), LockedToPart = false}), 14},\n\t}\n\tlocal shock = circle(sealHost, 2.5, STAR, 1, 0.2)\n\tlocal shockGlow = circle(sealHost, 7, VIOLET, 1, 0.1)\n\n\t-- The shatter -----------------------------------------------------------------------\n\tlocal tipEnd = centre - up * T.Bury\n\tlocal breakAt = Kit.attachment(swordHost)\n\tlocal shatter = {\n\t\t{emitter(\"StarFlare\", breakAt, {Color = ColorSequence.new(STAR), Size = curve({0, 24}, {1, 0}), Lifetime = NumberRange.new(0.3)}), 1},\n\t\t{emitter(\"Sparkle\", breakAt, {Color = colors(ASTRAL, VIOLET), Size = ns(9), Lifetime = NumberRange.new(0.6), LightEmission = 0.6}), 2},\n\t\t{emitter(\"HitFlash\", breakAt, {Color = ColorSequence.new(STAR), Size = curve({0, 14}, {1, 0}), Lifetime = NumberRange.new(0.15)}), 1},\n\t\t{emitter(\"SlashStar\", breakAt, {Color = colors(STAR, VIOLET)}), 12},\n\t}\n\tlocal params = Kit.rayParams({folder})\n\tlocal shards = Plan.shards(payload.seed)\n\tfor i, shard in ipairs(shards) do\n\t\tlocal point = centre + shard.offset\n\t\tlocal hit = workspace:Raycast(point + up * 8, -up * 24, params)\n\t\tshard.landing = if hit then hit.Position else point\n\t\tshard.start = tipEnd + up * (L * shard.along)\n\t\tlocal host = Kit.host(folder, \"Shard\" .. i, CFrame.new(shard.start))\n\t\tlocal core = Kit.attachment(host)\n\t\tlocal top, bottom = Kit.attachment(host), Kit.attachment(host)\n\t\ttop.Position, bottom.Position = Vector3.new(0, 0.35, 0), Vector3.new(0, -0.35, 0)\n\t\tshard.host = host\n\t\tshard.body = {\n\t\t\temitter(\"StarFlare\", core, {Color = ColorSequence.new(STAR), Size = curve({0, 3}, {1, 1.5}), Lifetime = NumberRange.new(0.15), Rate = 30,\n\t\t\t\tLockedToPart = true}),\n\t\t}\n\t\tshard.trail = Kit.trail(host, top, bottom, {Texture = Library.Streak.Texture, Color = colors(STAR, VIOLET), LightEmission = 1,\n\t\t\tBrightness = 2, FaceCamera = true, Lifetime = 0.2, Transparency = curve({0, 0}, {1, 1}), Enabled = false})\n\t\tlocal land = Kit.attachment(host)\n\t\tshard.landAt = land\n\t\tshard.burst = {\n\t\t\t{emitter(\"StarBurst\", land, {Color = colors(STAR, ASTRAL), Size = ns(7), Lifetime = NumberRange.new(0.4), LightEmission = 1}), 1},\n\t\t\t{emitter(\"StarFlare\", land, {Color = ColorSequence.new(STAR), Size = curve({0, 7}, {1, 0}), Lifetime = NumberRange.new(0.25)}), 1},\n\t\t\t{emitter(\"Sparkle\", land, {Color = colors(STAR, ASTRAL), Size = ns(5), Lifetime = NumberRange.new(0.6), LightEmission = 1}), 1},\n\t\t}\n\tend\n\n\t-- The blade's pose at `elapsed`: hilt, axis (hilt to tip), how much of it\n\t-- has formed, and whether it is there at all.\n\tlocal function pose(elapsed)\n\t\tif elapsed < T.Draw or elapsed >= shatterAt then return nil end\n\t\tif elapsed < turnAt then\n\t\t\treturn middle - up * (L / 2), up, Kit.smooth((elapsed - T.Draw) / T.Forge)\n\t\tend\n\t\tif elapsed < turnAt + T.Turn then\n\t\t\tlocal theta = math.pi * Kit.smooth((elapsed - turnAt) / T.Turn)\n\t\t\tlocal axis = up * math.cos(theta) + look * math.sin(theta)\n\t\t\treturn middle - axis * (L / 2), axis, 1\n\t\tend\n\t\tif elapsed < dropAt then\n\t\t\tlocal lift = T.Rise * Kit.smooth((elapsed - turnAt - T.Turn) / T.Windup)\n\t\t\treturn middle + up * (L / 2 + lift), -up, 1\n\t\tend\n\t\tif elapsed < impactAt then\n\t\t\tlocal d = math.clamp((elapsed - dropAt) / T.Drop, 0, 1)\n\t\t\tlocal from = middle + up * (T.Rise - L / 2)\n\t\t\treturn from:Lerp(tipEnd, d * d) + up * L, -up, 1\n\t\tend\n\t\tlocal age = elapsed - impactAt\n\t\tlocal quiver = side * (math.sin(age * 70) * 0.35 * math.exp(-age * 6))\n\t\treturn tipEnd + up * L + quiver, -up, 1\n\tend\n\n\tlocal spin = 0\n\tlocal last\n\tlocal timeline = Kit.drive(scope, payload.startedAt, total, function(elapsed)\n\t\tlocal dt = if last then math.max(elapsed - last, 0) else 0\n\t\tlast = elapsed\n\t\t-- The constellation draws, then fades into the blade.\n\t\tlocal chartFade = 1 - Kit.ramp(elapsed, T.Draw, T.Draw + T.Forge * 0.8)\n\t\tfor i, at in ipairs(points) do\n\t\t\tlocal shown = elapsed >= appear[i] and chartFade > 0.05\n\t\t\tKit.setEnabled(twinkles[i], shown)\n\t\tend\n\t\tfor _, link in ipairs(links) do\n\t\t\tlocal p = Kit.ramp(elapsed, link.start, link.start + 0.12)\n\t\t\tlink.a0.WorldPosition = stars[link.from]\n\t\t\tlink.a1.WorldPosition = stars[link.from]:Lerp(stars[link.to], p)\n\t\t\tfor _, beam in ipairs(link.beams) do Kit.opacity(beam, if p > 0 then chartFade * (if beam.Texture == \"\" then 1 else 0.6) else 0) end\n\t\tend\n\t\t-- The blade.\n\t\tlocal h, axis, grow = pose(elapsed)\n\t\tlocal shown = h ~= nil\n\t\tif shown then\n\t\t\tlocal reach = L * grow\n\t\t\thilt.WorldPosition = h\n\t\t\ttip.WorldPosition = h + axis * math.max(reach, 0.1)\n\t\t\ttipAt.WorldPosition = h + axis * reach\n\t\t\tpommel.WorldPosition = h - axis * 3 * grow\n\t\t\tguardL.WorldPosition = h - side * 3.2 * grow\n\t\t\tguardR.WorldPosition = h + side * 3.2 * grow\n\t\t\tbreakAt.WorldPosition = h + axis * (L / 2)\n\t\t\tfor _, s in ipairs(sparkles) do s.at.WorldPosition = h + axis * (reach * s.along) end\n\t\t\tfor _, layer in ipairs(blade) do\n\t\t\t\tlayer.beam.Width0, layer.beam.Width1 = layer.w0, layer.w1\n\t\t\tend\n\t\tend\n\t\tfor _, layer in ipairs(blade) do\n\t\t\tif layer.beam.Enabled ~= shown then layer.beam.Enabled = shown end\n\t\tend\n\t\tfor _, beam in ipairs(fittings) do\n\t\t\tif beam.Enabled ~= shown then beam.Enabled = shown end\n\t\tend\n\t\tKit.setEnabled(gleam, shown)\n\t\tfor _, s in ipairs(sparkles) do\n\t\t\tlocal on = shown and grow == 1\n\t\t\tif s.emitter.Enabled ~= on then s.emitter.Enabled = on end\n\t\tend\n\t\tlocal turning = elapsed >= turnAt and elapsed < dropAt\n\t\tif smear.Enabled ~= turning then smear.Enabled = turning end\n\t\tlocal falling = elapsed >= dropAt and elapsed < impactAt\n\t\tif streaks.Enabled ~= falling then streaks.Enabled = falling end\n\t\tswordLight.Brightness = if shown then 1.5 else 0\n\t\t-- The seal turns under it, flaring at the impact.\n\t\tlocal open = outward((elapsed - 0.1) / 0.5)\n\t\tlocal fade = 1 - Kit.ramp(elapsed, rainAt, rainAt + 0.7)\n\t\tlocal flare = if elapsed >= impactAt then 1 + 1.5 * math.exp(-(elapsed - impactAt) * 5) else 1\n\t\tlocal reach = R * open\n\t\tlocal glow = 0.5 * open * fade * flare\n\t\tlayoutCircle(shade, reach * 0.5, 0.35 * open * fade, 0.98 * open)\n\t\tlayoutCircle(rim, reach, open * fade)\n\t\tlayoutCircle(rimGlow, reach, glow)\n\t\tlayoutCircle(inner, reach * 0.55, open * fade)\n\t\tspin += dt * (if elapsed >= impactAt then 0.4 else 1.2)\n\t\tfor i = 1, 8 do\n\t\t\tlocal p = Kit.ramp(elapsed, 0.15 + (i - 1) * 0.05, 0.3 + (i - 1) * 0.05)\n\t\t\tlocal t0 = spin + (i - 1) * math.pi / 4\n\t\t\tlocal from = radial(t0) * reach * 0.92\n\t\t\tlocal to = from:Lerp(radial(t0 + 3 * math.pi / 4) * reach * 0.92, p)\n\t\t\tlayoutLine(octagram[i], from, to, if p > 0 then open * fade else 0)\n\t\t\tlayoutLine(octaGlow[i], from, to, if p > 0 then glow * 0.8 else 0)\n\t\tend\n\t\tsealLight.Brightness = 1.2 * open * fade * flare\n\t\t-- Shock rings out of the impact.\n\t\tlocal wave = (elapsed - impactAt) / 0.45\n\t\tlocal waveOn = wave >= 0 and wave <= 1\n\t\tlayoutCircle(shock, 2 + 22 * outward(wave), if waveOn then 1 - wave else 0, 1 - 0.7 * math.clamp(wave, 0, 1))\n\t\tlayoutCircle(shockGlow, 2 + 20 * outward(wave), if waveOn then 0.5 * (1 - wave) else 0)\n\t\t-- The shards of the shattered blade arc out and fall.\n\t\tfor _, shard in ipairs(shards) do\n\t\t\tlocal t = (elapsed - shatterAt) / shard.flight\n\t\t\tlocal flying = t >= 0 and t < 1\n\t\t\tif flying then\n\t\t\t\tlocal control = (shard.start + shard.landing) / 2 + up * shard.lift\n\t\t\t\tlocal position = shard.start:Lerp(control, t):Lerp(control:Lerp(shard.landing, t), t)\n\t\t\t\tshard.host.CFrame = CFrame.new(position)\n\t\t\tend\n\t\t\tKit.setEnabled(shard.body, flying)\n\t\t\tif shard.trail.Enabled ~= flying then shard.trail.Enabled = flying end\n\t\tend\n\tend, {folder})\n\n\ttimeline.at(0, function()\n\t\tKit.burst(call)\n\t\tKit.sound(handHost, SOUND_SWISH, 0.35, 1.4)\n\tend)\n\tfor i in ipairs(stars) do\n\t\ttimeline.at(appear[i], function()\n\t\t\tKit.burst(pops[i])\n\t\t\tKit.sound(skyHost, SOUND_CHIME, 0.15, 0.8 + i * 0.08)\n\t\tend)\n\tend\n\ttimeline.at(T.Draw, function()\n\t\tKit.burst(forge)\n\t\tKit.sound(swordHost, SOUND_SWISH, 0.5, 0.7)\n\tend)\n\ttimeline.at(turnAt, function()\n\t\tKit.sound(swordHost, SOUND_SWISH, 0.5, 1.1)\n\t\tImpactFX.shake(centre, 0.4, 0.2, 60)\n\tend)\n\ttimeline.at(impactAt, function()\n\t\tKit.burst(impact)\n\t\tKit.sound(sealHost, SOUND_BOOM, 0.8, 1.05)\n\t\tKit.sound(sealHost, SOUND_HIT, 0.5, 0.8)\n\t\tImpactFX.hit(centre + normal * 3, {tint = ASTRAL, pattern = \"triple\", shake = 2.4, shakeDuration = 0.6, punch = 9, radius = 90})\n\tend)\n\ttimeline.at(shatterAt, function()\n\t\tKit.burst(shatter)\n\t\tKit.sound(swordHost, SOUND_CHIME, 0.4, 0.6)\n\t\tImpactFX.shake(centre, 0.7, 0.2, 60)\n\tend)\n\tfor i, shard in ipairs(shards) do\n\t\ttimeline.at(shatterAt + shard.flight, function()\n\t\t\tshard.landAt.WorldPosition = shard.landing + up * 0.8\n\t\t\tKit.burst(shard.burst)\n\t\t\tif i % 4 == 0 then Kit.sound(shard.host, SOUND_CHIME, 0.2, 1.2 + i * 0.03) end\n\t\tend)\n\tend\n\ttimeline.at(rainAt, function()\n\t\tImpactFX.shake(centre, 0.8, 0.25, 60)\n\tend)\n\treturn true\nend\n\nreturn VFX\n"},
{path="ReplicatedStorage/Shared/Abilities/VFX/BlossomVFX",class="ModuleScript",source="local ImportedAudio = require(game:GetService(\"ReplicatedStorage\").Shared.Audio.DownloadedSounds)\n-- Blossom Road, drawn from one message:\n--   gust    a ribbon of petals runs out along the lane from the caster's feet\n--   blooms  flowers burst up behind it one after another, each throwing\n--           petals and sparkles, with a rising chime\n--   finale  the last flower blooms huge: a petal storm, a ring and a glow,\n--           with impact frames, a shake and a punch\n--   road    the lane stays as a soft pink road edged in light, petals and\n--           mending sparkles drifting up from it, then fades\n-- Every visible effect is an authored particle, trail or textured Beam; Parts\n-- are invisible emitter hosts only.\nlocal Plan = require(script.Parent.Parent.BlossomPlan)\nlocal Kit = require(script.Parent.AbilityKit)\nlocal ImpactFX = require(script.Parent.ImpactFX)\nlocal Library = require(script.Parent.BlossomParticles)\n\nlocal VFX = {}\nlocal T = Plan.Tuning\nlocal SAKURA = Color3.fromRGB(255, 172, 206)\nlocal BLUSH = Color3.fromRGB(255, 112, 166)\nlocal CREAM = Color3.fromRGB(255, 240, 246)\nlocal POLLEN = Color3.fromRGB(255, 226, 140)\nlocal MEND = Color3.fromRGB(150, 255, 170)\nlocal ns, curve, colors = Kit.ns, Kit.curve, Kit.colors\nlocal live = 0\nlocal preloaded = false\n\n-- VFX :D flipbook sheets and pack textures the curated library does not carry.\nlocal Sheets = {\n\t-- VFX :D.20 Images/flowerflip: a blossom opening.\n\tFlower = {\n\t\tTexture = \"rbxassetid://16940454301\",\n\t\tFlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,\n\t\tFlipbookMode = Enum.ParticleFlipbookMode.OneShot,\n\t},\n\t-- VFX :D.1 Images/sparkle_flip: four-point sparkles.\n\tSparkle = {\n\t\tTexture = \"rbxassetid://115317702570755\",\n\t\tFlipbookLayout = Enum.ParticleFlipbookLayout.Grid4x4,\n\t\tFlipbookMode = Enum.ParticleFlipbookMode.OneShot,\n\t\tLightEmission = 1,\n\t},\n\t-- Slash VFX Trail2: a soft band, the road and its glowing edges.\n\tBand = {Texture = \"rbxassetid://16892374733\"},\n}\n\nlocal SOUND_GUST = ImportedAudio.ability_magic_cast\nlocal SOUND_BLOOM = ImportedAudio.ability_magic_glow\nlocal SOUND_FINALE = ImportedAudio.ability_magic_poof\n\nfunction VFX.preload()\n\tif preloaded then return end\n\tpreloaded = true\n\tKit.preload(Kit.textures(Library, Sheets), {SOUND_GUST, SOUND_BLOOM, SOUND_FINALE})\nend\n\nfunction VFX.duration()\n\treturn Plan.duration()\nend\n\nlocal function emitter(kind, parent, props)\n\treturn Kit.emitter(if Sheets[kind] then Sheets else Library, kind, parent, props)\nend\n\n-- Petals tumbling: the toon petal flipbook loops so each petal flutters.\nlocal function petals(parent, props)\n\tlocal base = {\n\t\tColor = colors(SAKURA, BLUSH), Size = curve({0, 0}, {0.1, 1.1, 0.4}, {0.85, 0.9, 0.3}, {1, 0}),\n\t\tLifetime = NumberRange.new(1.2, 1.9), Speed = NumberRange.new(4, 10), SpreadAngle = Vector2.new(60, 60),\n\t\tAcceleration = Vector3.new(0, -5, 0), Drag = 2, Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-220, 220),\n\t\tLightInfluence = 0, LightEmission = 0, Brightness = 1, FlipbookMode = Enum.ParticleFlipbookMode.Loop,\n\t\tFlipbookFramerate = NumberRange.new(10, 18), EmissionDirection = Enum.NormalId.Top, LockedToPart = false,\n\t}\n\tfor key, value in pairs(props or {}) do base[key] = value end\n\treturn emitter(\"Petal\", parent, base)\nend\n\n-- A flat ribbon on the ground between two points (width runs across the lane).\nlocal function groundRibbon(parent, from, to, width, color, emission)\n\tlocal forward = Kit.flat(to - from)\n\tlocal side = forward:Cross(Vector3.yAxis).Unit\n\tlocal a0 = Kit.attachment(parent, CFrame.fromMatrix(from, forward, side))\n\tlocal a1 = Kit.attachment(parent, CFrame.fromMatrix(to, forward, side))\n\treturn Kit.beam(parent, a0, a1, {\n\t\tTexture = Sheets.Band.Texture, TextureMode = Enum.TextureMode.Stretch, TextureLength = 1, FaceCamera = false,\n\t\tSegments = 2, Width0 = width, Width1 = width, Color = ColorSequence.new(color), LightEmission = emission,\n\t\tBrightness = 1.6, ZOffset = 0.1, Transparency = ns(1), Enabled = false,\n\t})\nend\n\nfunction VFX.play(payload, scope)\n\tif typeof(payload.feet) ~= \"Vector3\" or typeof(payload.direction) ~= \"Vector3\" or type(payload.points) ~= \"table\"\n\t\tor #payload.points == 0 or type(payload.startedAt) ~= \"number\" then\n\t\treturn false\n\tend\n\tlocal points = {}\n\tfor i, p in ipairs(payload.points) do\n\t\tif typeof(p) ~= \"Vector3\" or i > T.Blooms then return false end\n\t\tpoints[i] = p\n\tend\n\tlocal finaleAt = Plan.finaleAt(#points)\n\tlocal roadEnd = finaleAt + T.Road\n\tlocal total = roadEnd + 0.4\n\tif workspace:GetServerTimeNow() - payload.startedAt >= total or live >= 3 then return false end\n\tlive += 1\n\tscope:add(function() live -= 1 end)\n\tVFX.preload()\n\n\tlocal feet, direction = payload.feet, Plan.flat(payload.direction)\n\tlocal up = Vector3.yAxis\n\tlocal last = points[#points]\n\tlocal folder = scope:add(Instance.new(\"Folder\"))\n\tfolder.Name = \"BlossomRoad\"\n\tfolder.Parent = workspace\n\n\t-- Cast ---------------------------------------------------------------------\n\tlocal castHost = Kit.host(folder, \"Cast\", CFrame.new(feet))\n\tlocal castAt = Kit.attachment(castHost, CFrame.new(feet + up * 1.5))\n\tlocal cast = {\n\t\t{petals(castAt, {Speed = NumberRange.new(8, 16), SpreadAngle = Vector2.new(75, 75)}), 24},\n\t\t{emitter(\"Sparkle\", castAt, {Color = colors(CREAM, SAKURA), Size = ns(3), Lifetime = NumberRange.new(0.5),\n\t\t\tFlipbookFramerate = NumberRange.new(30), Speed = NumberRange.new(4, 8), SpreadAngle = Vector2.new(90, 90), LightInfluence = 0}), 4},\n\t\t{emitter(\"StarLight\", castAt, {Color = ColorSequence.new(SAKURA), Size = curve({0, 4}, {1, 9}), Lifetime = NumberRange.new(0.5), Brightness = 1}), 1},\n\t}\n\n\t-- Gust: runs along the lane just ahead of the blooms.\n\tlocal gust = Kit.host(folder, \"Gust\", CFrame.new(feet + up * 1.4))\n\tlocal gustTop = Kit.attachment(gust); gustTop.Position = Vector3.new(0, 1.1, 0)\n\tlocal gustBottom = Kit.attachment(gust); gustBottom.Position = Vector3.new(0, -1.1, 0)\n\tlocal gustTrail = Kit.trail(gust, gustTop, gustBottom, {\n\t\tTexture = Library.Trail.Texture, TextureMode = Library.Trail.TextureMode, TextureLength = Library.Trail.TextureLength,\n\t\tColor = colors(CREAM, SAKURA, BLUSH), Transparency = curve({0, 0.2}, {1, 1}), WidthScale = curve({0, 1}, {1, 0.4}),\n\t\tLifetime = 0.35, LightEmission = 0.6, Brightness = 1.5, FaceCamera = true, Enabled = false,\n\t})\n\tlocal gustAt = Kit.attachment(gust)\n\tlocal gustEmitters = {\n\t\tpetals(gustAt, {Rate = 80, Speed = NumberRange.new(2, 6), SpreadAngle = Vector2.new(180, 180), Lifetime = NumberRange.new(0.9, 1.5)}),\n\t\temitter(\"Pollen\", gustAt, {Color = ColorSequence.new(POLLEN), Rate = 30, Speed = NumberRange.new(2, 6), Lifetime = NumberRange.new(0.5, 0.9),\n\t\t\tSize = curve({0, 0}, {1, 0.5}), LockedToPart = false}),\n\t}\n\tlocal function lanePoint(t)\n\t\t-- Feet to first bloom to last, by distance travelled.\n\t\tlocal path = {feet, table.unpack(points)}\n\t\tlocal lengths, sum = {}, 0\n\t\tfor i = 1, #path - 1 do\n\t\t\tlengths[i] = (path[i + 1] - path[i]).Magnitude\n\t\t\tsum += lengths[i]\n\t\tend\n\t\tlocal want = t * sum\n\t\tfor i = 1, #path - 1 do\n\t\t\tif want <= lengths[i] or i == #path - 1 then\n\t\t\t\treturn path[i]:Lerp(path[i + 1], math.clamp(want / math.max(lengths[i], 1e-3), 0, 1))\n\t\t\tend\n\t\t\twant -= lengths[i]\n\t\tend\n\t\treturn last\n\tend\n\n\t-- Blooms -------------------------------------------------------------------\n\tlocal blooms = {}\n\tfor index, point in ipairs(points) do\n\t\tlocal host = Kit.host(folder, \"Bloom\" .. index, CFrame.new(point))\n\t\tlocal at = Kit.attachment(host, CFrame.new(point + up * 2.4))\n\t\tlocal low = Kit.attachment(host, CFrame.new(point + up * 0.6))\n\t\tlocal size = 7.5 + index * 0.3\n\t\tblooms[index] = {\n\t\t\thost = host,\n\t\t\tlayers = {\n\t\t\t\t{emitter(\"Flower\", at, {Color = colors(SAKURA, BLUSH), Size = curve({0, size * 0.5}, {0.3, size}, {1, size * 1.1}),\n\t\t\t\t\tLifetime = NumberRange.new(0.9), FlipbookFramerate = NumberRange.new(30), LightInfluence = 0, LightEmission = 0, ZOffset = 0.5,\n\t\t\t\t\tRotation = NumberRange.new(-25, 25), Speed = NumberRange.new(0.01), Transparency = curve({0, 0}, {0.75, 0}, {1, 1})}), 1},\n\t\t\t\t{emitter(\"Flower\", at, {Color = ColorSequence.new(CREAM), Size = curve({0, size * 0.25}, {1, size * 0.55}),\n\t\t\t\t\tLifetime = NumberRange.new(0.75), FlipbookFramerate = NumberRange.new(36), LightInfluence = 0, LightEmission = 0.3,\n\t\t\t\t\tRotation = NumberRange.new(20, 70), Speed = NumberRange.new(0.01), ZOffset = 0.8}), 1},\n\t\t\t\t{petals(low, {Speed = NumberRange.new(10, 20), SpreadAngle = Vector2.new(55, 55)}), 14},\n\t\t\t\t{emitter(\"Sparkle\", at, {Color = colors(CREAM, SAKURA), Size = ns(2.2), Lifetime = NumberRange.new(0.45, 0.6),\n\t\t\t\t\tFlipbookFramerate = NumberRange.new(30), Speed = NumberRange.new(5, 10), SpreadAngle = Vector2.new(120, 120), LightInfluence = 0}), 3},\n\t\t\t\t{emitter(\"StarLight\", at, {Color = ColorSequence.new(SAKURA), Size = curve({0, 4}, {1, 8}), Lifetime = NumberRange.new(0.45), Brightness = 0.8}), 1},\n\t\t\t\t{emitter(\"Pollen\", at, {Color = ColorSequence.new(POLLEN), Speed = NumberRange.new(8, 16), Lifetime = NumberRange.new(0.4, 0.7),\n\t\t\t\t\tSize = curve({0, 0}, {1, 0.6}), LockedToPart = false}), 8},\n\t\t\t},\n\t\t}\n\tend\n\n\t-- Finale -------------------------------------------------------------------\n\tlocal finaleHost = Kit.host(folder, \"Finale\", CFrame.new(last))\n\tlocal crown = Kit.attachment(finaleHost, CFrame.new(last + up * 4))\n\tlocal base = Kit.attachment(finaleHost, CFrame.new(last + up * 0.8))\n\tlocal finale = {\n\t\t{emitter(\"Flower\", crown, {Color = colors(SAKURA, BLUSH), Size = curve({0, 6}, {0.3, 18}, {1, 20}), Lifetime = NumberRange.new(1.1),\n\t\t\tFlipbookFramerate = NumberRange.new(24), LightInfluence = 0, LightEmission = 0, ZOffset = 0.5, Speed = NumberRange.new(0.01),\n\t\t\tTransparency = curve({0, 0}, {0.75, 0}, {1, 1})}), 1},\n\t\t{emitter(\"Flower\", crown, {Color = ColorSequence.new(CREAM), Size = curve({0, 4}, {1, 10}), Lifetime = NumberRange.new(0.9),\n\t\t\tFlipbookFramerate = NumberRange.new(28), LightInfluence = 0, LightEmission = 0.3, Rotation = NumberRange.new(30, 60),\n\t\t\tSpeed = NumberRange.new(0.01), ZOffset = 0.8}), 1},\n\t\t{petals(base, {Speed = NumberRange.new(18, 36), SpreadAngle = Vector2.new(80, 80), Lifetime = NumberRange.new(1.4, 2.2),\n\t\t\tSize = curve({0, 0}, {0.08, 1.4, 0.5}, {0.85, 1.1, 0.4}, {1, 0})}), 60},\n\t\t{emitter(\"Shockwave\", crown, {Color = ColorSequence.new(SAKURA), Orientation = Enum.ParticleOrientation.FacingCamera,\n\t\t\tSize = curve({0, 4}, {0.5, 22}, {1, 28}), Brightness = 1.5, Lifetime = NumberRange.new(0.55), Transparency = curve({0, 0}, {1, 1})}), 1},\n\t\t{emitter(\"HitGlow\", crown, {Color = ColorSequence.new(SAKURA), Size = curve({0, 0}, {0.3, 9}, {1, 12}), Brightness = 0.7}), 1},\n\t\t{emitter(\"HitStar\", crown, {Color = colors(CREAM, SAKURA), Size = curve({0, 10, 2}, {1, 3}), Brightness = 1.6,\n\t\t\tLifetime = NumberRange.new(0.15, 0.3)}), 4},\n\t\t{emitter(\"Sparkle\", crown, {Color = colors(CREAM, SAKURA), Size = ns(3.5), Lifetime = NumberRange.new(0.6, 0.8),\n\t\t\tFlipbookFramerate = NumberRange.new(24), Speed = NumberRange.new(12, 22), SpreadAngle = Vector2.new(180, 180),\n\t\t\tDrag = 3, LightInfluence = 0}), 10},\n\t\t{emitter(\"Glints\", crown, {Color = ColorSequence.new(SAKURA), EmissionDirection = Enum.NormalId.Top,\n\t\t\tSpreadAngle = Vector2.new(180, 180), Speed = NumberRange.new(20, 50), Brightness = 2}), 20},\n\t\t{emitter(\"StarLight\", crown, {Color = ColorSequence.new(SAKURA), Size = curve({0, 10}, {1, 22}), Lifetime = NumberRange.new(0.7), Brightness = 0.5}), 1},\n\t}\n\tlocal finaleLight = Kit.light(finaleHost, SAKURA, 36)\n\n\t-- Road ---------------------------------------------------------------------\n\tlocal road = Kit.host(folder, \"Road\", CFrame.new(feet))\n\tlocal ribbons = {}\n\tlocal path = {feet, table.unpack(points)}\n\tfor i = 1, #path - 1 do\n\t\tlocal a, b = path[i] + up * 0.15, path[i + 1] + up * 0.15\n\t\tlocal side = Kit.flat(b - a):Cross(up).Unit\n\t\ttable.insert(ribbons, {beam = groundRibbon(road, a, b, T.RoadWidth * 1.8, SAKURA, 0.6), opacity = 0.35})\n\t\ttable.insert(ribbons, {beam = groundRibbon(road, a + side * T.RoadWidth * 0.85, b + side * T.RoadWidth * 0.85, 1.6, SAKURA, 1), opacity = 0.85})\n\t\ttable.insert(ribbons, {beam = groundRibbon(road, a - side * T.RoadWidth * 0.85, b - side * T.RoadWidth * 0.85, 1.6, SAKURA, 1), opacity = 0.85})\n\tend\n\t-- One box-shaped host per segment, so drift rises from the whole road.\n\tlocal drift = {}\n\tfor i = 1, #path - 1 do\n\t\tlocal a, b = path[i], path[i + 1]\n\t\tlocal mid = (a + b) / 2 + up * 0.4\n\t\tlocal segment = Kit.host(folder, \"RoadSegment\" .. i, CFrame.lookAt(mid, mid + Kit.flat(b - a)),\n\t\t\tVector3.new(T.RoadWidth * 1.6, 0.3, math.max((b - a).Magnitude, 1)))\n\t\ttable.insert(drift, petals(segment, {Rate = 5, Speed = NumberRange.new(1, 3), Acceleration = Vector3.new(0, 1.5, 0),\n\t\t\tLifetime = NumberRange.new(1.4, 2), Shape = Enum.ParticleEmitterShape.Box, Size = curve({0, 0}, {0.15, 0.8, 0.3}, {0.85, 0.7}, {1, 0})}))\n\t\ttable.insert(drift, emitter(\"Sparkle\", segment, {Color = colors(MEND, CREAM), Size = ns(1.4), Rate = 2.5, Lifetime = NumberRange.new(0.7, 1),\n\t\t\tFlipbookFramerate = NumberRange.new(18), Speed = NumberRange.new(1.5, 3), EmissionDirection = Enum.NormalId.Top,\n\t\t\tShape = Enum.ParticleEmitterShape.Box, LightInfluence = 0}))\n\t\ttable.insert(drift, emitter(\"Health\", segment, {Color = ColorSequence.new(MEND), Size = curve({0, 0}, {0.2, 0.7}, {0.8, 0.7}, {1, 0}),\n\t\t\tRate = 1.2, Speed = NumberRange.new(2, 4), Lifetime = NumberRange.new(0.9, 1.2), EmissionDirection = Enum.NormalId.Top,\n\t\t\tSpreadAngle = Vector2.new(10, 10), LightEmission = 0.4, Brightness = 1.5, LockedToPart = false, Shape = Enum.ParticleEmitterShape.Box}))\n\tend\n\n\tlocal gustEnd = Plan.bloomAt(#points)\n\tlocal timeline = Kit.drive(scope, payload.startedAt, total, function(elapsed)\n\t\tlocal running = elapsed < gustEnd + 0.05\n\t\tif running then\n\t\t\tgust.CFrame = CFrame.lookAt(lanePoint(math.clamp(elapsed / gustEnd, 0, 1)) + up * 1.4, lanePoint(1) + up * 1.4)\n\t\tend\n\t\tgustTrail.Enabled = running\n\t\tKit.setEnabled(gustEmitters, running)\n\t\t-- The road fades in behind the gust and out at the end.\n\t\tlocal shown = Kit.ramp(elapsed, 0.1, finaleAt) * (1 - Kit.ramp(elapsed, roadEnd - 0.7, roadEnd))\n\t\tfor _, ribbon in ipairs(ribbons) do\n\t\t\tKit.opacity(ribbon.beam, shown * ribbon.opacity * (0.85 + 0.15 * math.sin(elapsed * 4)))\n\t\tend\n\t\tKit.setEnabled(drift, elapsed >= finaleAt and elapsed < roadEnd - 0.6)\n\t\tlocal age = elapsed - finaleAt\n\t\tfinaleLight.Brightness = if age >= 0 then math.exp(-age * 4) * 3 else 0\n\tend, {folder})\n\n\ttimeline.at(0, function()\n\t\tKit.burst(cast)\n\t\tKit.sound(castHost, SOUND_GUST, 0.45, 1.5)\n\tend)\n\tfor index, bloom in ipairs(blooms) do\n\t\ttimeline.at(Plan.bloomAt(index), function()\n\t\t\tKit.burst(bloom.layers)\n\t\t\tKit.sound(bloom.host, SOUND_BLOOM, 0.22, 0.9 + index * 0.07)\n\t\t\tImpactFX.shake(points[index], 0.25, 0.15, 45)\n\t\tend)\n\tend\n\ttimeline.at(finaleAt, function()\n\t\tKit.burst(finale)\n\t\tKit.sound(finaleHost, SOUND_FINALE, 0.5, 1.4)\n\t\tImpactFX.hit(last, {tint = BLUSH, pattern = \"double\", shake = 1.5, shakeDuration = 0.45, punch = 5, radius = 75})\n\tend)\n\treturn true\nend\n\nreturn VFX\n"},
{path="ReplicatedStorage/Shared/Abilities/VFX/ThunderVFX",class="ModuleScript",source="local ImportedAudio = require(game:GetService(\"ReplicatedStorage\").Shared.Audio.DownloadedSounds)\n-- Thunderhead, built from complete pack assemblies:\n--   gather  the Storm Cloud rolls in over the aim, the world darkens, and\n--           Lightning Surge crackles at each spot about to be struck\n--   bolts   Stylized Thunder's lightning drops on each spot with a spiky\n--           ground splash (Impact #12, #37) and a ring (Impact #36), exactly\n--           when the server's hit lands\n--   final   the biggest strike in the middle, with impact frames and a shake\n--   decay   the cloud thins, the light returns, lightning fades off the ground\nlocal Lighting = game:GetService(\"Lighting\")\nlocal Plan = require(script.Parent.Parent.ThunderPlan)\nlocal Kit = require(script.Parent.AbilityKit)\nlocal ImpactFX = require(script.Parent.ImpactFX)\nlocal Pack = require(script.Parent.PackAssembly)\n\nlocal VFX = {}\nlocal T = Plan.Tuning\nlocal ICE = Color3.fromRGB(235, 252, 255)\nlocal CYAN = Color3.fromRGB(60, 225, 255)\nlocal AZURE = Color3.fromRGB(16, 120, 225)\nlocal TINT = {deep = AZURE, main = CYAN, hot = ICE}\n-- White-hot bolts edged cyan; the storm cloud stays a heavy steel blue.\nlocal BOLT = {deep = CYAN, main = ICE, hot = Color3.new(1, 1, 1)}\nlocal STORM = {deep = Color3.fromRGB(128, 132, 146), main = Color3.fromRGB(128, 132, 146), hot = Color3.fromRGB(168, 172, 184)}\nlocal live = 0\nlocal preloaded = false\n\nlocal SOUND_RUMBLE = ImportedAudio.ability_charge\nlocal SOUND_BOOM = ImportedAudio.ability_lightning\nlocal SOUND_HIT = ImportedAudio.ability_impact_heavy\n\nfunction VFX.preload()\n\tPack.preload()\n\tif preloaded then return end\n\tpreloaded = true\n\tKit.preload({}, {SOUND_RUMBLE, SOUND_BOOM, SOUND_HIT})\nend\n\nfunction VFX.duration()\n\treturn Plan.duration()\nend\n\nfunction VFX.play(payload, scope)\n\tif typeof(payload.origin) ~= \"CFrame\" or typeof(payload.centre) ~= \"Vector3\" or typeof(payload.normal) ~= \"Vector3\"\n\t\tor type(payload.points) ~= \"table\" or type(payload.startedAt) ~= \"number\" then\n\t\treturn false\n\tend\n\tlocal total = Plan.duration()\n\tif workspace:GetServerTimeNow() - payload.startedAt >= total or live >= 3 then return false end\n\tlive += 1\n\tscope:add(function() live -= 1 end)\n\tVFX.preload()\n\n\tlocal centre = payload.centre\n\tlocal up = Vector3.yAxis\n\tlocal finalAt = Plan.finalAt()\n\tlocal folder = scope:add(Instance.new(\"Folder\"))\n\tfolder.Name = \"Thunderhead\"\n\tfolder.Parent = workspace\n\tPack.endWithCaster(scope, payload.caster)\n\tlocal function mount(name, cframe, scale, budget)\n\t\treturn Pack.mount(scope, folder, name, {cframe = cframe, scale = scale, budget = budget, tint = TINT, brightness = 2.5})\n\tend\n\n\t-- The storm ------------------------------------------------------------------\n\tlocal cloudAt = CFrame.new(centre + up * T.CloudHeight)\n\tlocal cloud = Pack.mount(scope, folder, \"StormCloud\", {cframe = cloudAt, scale = 0.4, visible = true, tint = STORM, hide = {Wind = true}})\n\tcloud:centreOn(\"Soul Cloud\")\n\tcloud:place(cloudAt)\n\tcloud:fade(0)\n\tlocal gloom = mount(\"Thunder\", CFrame.new(centre + up * T.CloudHeight * 0.5), 0.6, 40)\n\tgloom:only(\"Clouds\"):stream(true)\n\tlocal grade = scope:add(Instance.new(\"ColorCorrectionEffect\"))\n\tgrade.Name = \"ThunderheadGloom\"\n\tgrade.Parent = Lighting\n\tlocal light = Kit.light(Kit.host(folder, \"Glow\", CFrame.new(centre + up * 6)), CYAN, 60)\n\n\tlocal sparks = {}\n\tfor i, point in ipairs(payload.points) do\n\t\tsparks[i] = mount(\"LightningSurge\", CFrame.new(point + up), 1.2, 30)\n\tend\n\tlocal rim = mount(\"LightningSurge\", CFrame.new(centre + up), 2.6, 50)\n\trim:stream(true)\n\n\tlocal flash = 0\n\tlocal function strike(point, scale, grand)\n\t\tlocal frame = CFrame.lookAt(point + up * 1.5, point + up * 10)\n\t\tPack.bolt(scope, folder, point, {tint = BOLT, scale = 5.5 * scale, height = 14 * scale, width = 7 * scale})\n\t\t-- A solid column for the instant the bolt connects.\n\t\tlocal column = mount(\"KiBlast4\", CFrame.new(point), 0.75 * scale)\n\t\tcolumn:taper(0.55)\n\t\tcolumn:stretch(point + up * T.CloudHeight, point)\n\t\tcolumn:beamsOn(true)\n\t\tscope:delay(0.13, function() column:beamsOn(false) end)\n\t\tmount(\"Impact45\", frame, 0.95 * scale):burst(0.8)\n\t\tmount(\"Impact12\", frame, 2.6 * scale):burst(1)\n\t\tmount(\"Impact37\", frame, 2.2 * scale):burst(1)\n\t\tmount(\"Impact36\", frame, 3.2 * scale):burst(1)\n\t\tflash = if grand then 1 else 0.7\n\t\tKit.sound(folder, SOUND_BOOM, if grand then 0.8 else 0.5, if grand then 0.8 else 1.1 + scale * 0.1)\n\t\tKit.sound(folder, SOUND_HIT, 0.4, 0.7)\n\tend\n\n\tlocal timeline = Kit.drive(scope, payload.startedAt, total, function(elapsed)\n\t\tlocal arrive = Kit.smooth(elapsed / (T.Gather * 0.8))\n\t\tlocal leave = 1 - Kit.smooth((elapsed - finalAt - 0.35) / 0.8)\n\t\tlocal presence = arrive * leave\n\t\tcloud:fade(presence)\n\t\tcloud:place(cloudAt * CFrame.Angles(0, elapsed * 0.25, 0) + up * (8 * (1 - arrive)))\n\t\tgrade.Brightness = -0.1 * presence + 0.2 * flash\n\t\tgrade.Contrast = 0.12 * presence\n\t\tgrade.TintColor = Color3.new(1, 1, 1):Lerp(Color3.fromRGB(205, 222, 240), presence)\n\t\tflash = math.max(flash - 0.09, 0)\n\t\tlight.Brightness = 2.5 * flash\n\tend, {folder})\n\n\ttimeline.at(0, function()\n\t\tKit.sound(folder, SOUND_RUMBLE, 0.5, 0.4)\n\t\tImpactFX.shake(centre, 0.4, T.Gather, 70)\n\tend)\n\tfor i, point in ipairs(payload.points) do\n\t\ttimeline.at(math.max(Plan.boltAt(i) - 0.35, 0), function() sparks[i]:stream(true) end)\n\t\ttimeline.at(Plan.boltAt(i), function()\n\t\t\tsparks[i]:stream(false)\n\t\t\tstrike(point, 1, false)\n\t\t\tImpactFX.shake(point, 1.2, 0.3, 70)\n\t\tend)\n\tend\n\ttimeline.at(finalAt, function()\n\t\tstrike(centre, 1.6, true)\n\t\tImpactFX.hit(centre + up * 3, {tint = CYAN, pattern = \"double\", shake = 2.4, shakeDuration = 0.6, punch = 8, radius = 100})\n\tend)\n\ttimeline.at(finalAt + 0.4, function()\n\t\trim:stream(false)\n\t\tgloom:stream(false)\n\tend)\n\treturn true\nend\n\nreturn VFX\n"},
{path="ReplicatedStorage/Shared/Abilities/VFX/CometVFX",class="ModuleScript",source="local ImportedAudio = require(game:GetService(\"ReplicatedStorage\").Shared.Audio.DownloadedSounds)\n-- Azure Comet, built from complete pack assemblies. Reference: a heavy blue\n-- comet out of the sky, then a white-cyan lightning detonation.\n--   gather  a ring of light opens high over the caster (Impact #10) and the\n--           BZ1 Fireball, turned ice blue, swells inside it, spitting lightning\n--   dive    it falls at the aim with Ki Blast 4's beams as its long tail, while\n--           a warning glow sharpens on the ground\n--   impact  a white flash, a star (Impact #12, #37), long horizontal streaks of\n--           Ki Blast beam, Stylized Thunder's lightning crashing round the\n--           crater and a ground ring (Impact #36) on the server's hit\n--   pulses  each damage tick is a smaller crack of lightning and a ring\n-- The comet's body is the pack's mesh fireball; other Parts are invisible hosts.\nlocal Plan = require(script.Parent.Parent.CometPlan)\nlocal Kit = require(script.Parent.AbilityKit)\nlocal ImpactFX = require(script.Parent.ImpactFX)\nlocal Pack = require(script.Parent.PackAssembly)\n\nlocal VFX = {}\nlocal T = Plan.Tuning\nlocal ICE = Color3.fromRGB(232, 250, 255)\nlocal CYAN = Color3.fromRGB(64, 215, 255)\nlocal AZURE = Color3.fromRGB(20, 96, 240)\nlocal TINT = {deep = AZURE, main = CYAN, hot = ICE}\nlocal BOLT = {deep = CYAN, main = ICE, hot = Color3.new(1, 1, 1)}\nlocal BODY = {deep = CYAN, main = ICE, hot = Color3.new(1, 1, 1)}\nlocal VIEW_HEIGHT, VIEW_BEYOND = 38, 34\nlocal live = 0\nlocal preloaded = false\n\nlocal SOUND_SWISH = ImportedAudio.ability_whoosh\nlocal SOUND_BOOM = ImportedAudio.ability_impact_heavy\nlocal SOUND_HIT = ImportedAudio.ability_ice_break\n\nfunction VFX.preload()\n\tPack.preload()\n\tif preloaded then return end\n\tpreloaded = true\n\tKit.preload({}, {SOUND_SWISH, SOUND_BOOM, SOUND_HIT})\nend\n\nfunction VFX.duration()\n\treturn Plan.duration()\nend\n\nfunction VFX.play(payload, scope)\n\tif typeof(payload.origin) ~= \"CFrame\" or typeof(payload.sky) ~= \"Vector3\" or typeof(payload.impact) ~= \"Vector3\"\n\t\tor typeof(payload.normal) ~= \"Vector3\" or type(payload.startedAt) ~= \"number\" or type(payload.seed) ~= \"number\" then\n\t\treturn false\n\tend\n\tlocal total = Plan.duration()\n\tif workspace:GetServerTimeNow() - payload.startedAt >= total or live >= 3 then return false end\n\tlive += 1\n\tscope:add(function() live -= 1 end)\n\tVFX.preload()\n\n\tlocal origin, impact, normal = payload.origin, payload.impact, payload.normal\n\t-- Drawn from the sky beyond the aim, on screen and coming at the caster,\n\t-- rather than from the cast's own sky point overhead where the camera never\n\t-- sees it. It lands on the server's point at the server's moment either way.\n\tlocal toward = (impact - origin.Position) * Vector3.new(1, 0, 1)\n\ttoward = if toward.Magnitude > 0.1 then toward.Unit else origin.LookVector\n\tlocal sky = impact + Vector3.yAxis * VIEW_HEIGHT + toward * VIEW_BEYOND\n\tlocal impactAt = Plan.impactAt()\n\tlocal folder = scope:add(Instance.new(\"Folder\"))\n\tfolder.Name = \"AzureComet\"\n\tfolder.Parent = workspace\n\tlocal function mount(name, cframe, scale, budget)\n\t\treturn Pack.mount(scope, folder, name, {cframe = cframe, scale = scale, budget = budget, tint = TINT, brightness = 2.5})\n\tend\n\n\t-- A dead caster's comet never lands on the server, so it stops here too.\n\tPack.endWithCaster(scope, payload.caster)\n\n\tlocal heading = if (impact - sky).Magnitude > 0.1 then (impact - sky).Unit else -Vector3.yAxis\n\tlocal aim = CFrame.lookAt(sky, sky + heading)\n\n\tlocal cometHost = Kit.host(folder, \"Comet\", aim)\n\tlocal comet = Pack.mount(scope, folder, \"BZ1Fireball\", {cframe = aim, scale = 0.5, budget = 200, tint = TINT, meshTint = BODY, brightness = 2.5, visible = true})\n\tcomet:trailBeams(\"EFFECTS HOLDER\")\n\tcomet:slim(0.42)\n\tcomet:place(aim)\n\tcomet:stream(true)\n\tcomet:beamsOn(true)\n\tlocal halo = mount(\"Impact10\", aim, 1.1, 120)\n\thalo:stream(true)\n\thalo:beamsOn(true)\n\tlocal crackle = mount(\"LightningSurge\", aim, 2.2, 40)\n\tcrackle:stream(true)\n\tlocal tail = mount(\"KiBlast4\", aim, 0.6)\n\ttail:taper(0.15)\n\tlocal cometLight = Kit.light(cometHost, CYAN, 30)\n\n\t-- The landing, shown the moment the comet leaves the sky.\n\tlocal crater = CFrame.lookAt(impact + normal * 1.5, impact + normal * 10)\n\tlocal craterHost = Kit.host(folder, \"Crater\", crater)\n\tlocal craterLight = Kit.light(craterHost, CYAN, 55)\n\tlocal warning = mount(\"LightningSurge\", crater, 3, 40)\n\n\tlocal across = normal:Cross(heading)\n\tacross = if across.Magnitude > 0.1 then across.Unit else Vector3.xAxis\n\tlocal forward = across:Cross(normal).Unit\n\tlocal flat = impact + normal * 3\n\tlocal streaks = {mount(\"KiBlast4\", crater, 0.9), mount(\"KiBlast4\", crater, 0.55)}\n\tfor _, streak in ipairs(streaks) do streak:taper(0.05) end\n\tstreaks[1]:stretch(flat + across * 45, flat - across * 45)\n\tstreaks[2]:stretch(flat + forward * 26, flat - forward * 26)\n\tlocal embers\n\n\tlocal timeline = Kit.drive(scope, payload.startedAt, total, function(elapsed)\n\t\tlocal swell = 0.3 + 0.7 * Kit.smooth(elapsed / T.Charge)\n\t\tcomet:rescale(math.round(swell * 10) / 10 * 1.5)\n\t\tlocal position, along = Plan.flight(sky, impact, elapsed)\n\t\tif elapsed < impactAt then\n\t\t\tlocal frame = CFrame.lookAt(position, position + heading)\n\t\t\tcomet:place(frame)\n\t\t\thalo:place(frame)\n\t\t\tcrackle:place(frame)\n\t\t\tcometHost.CFrame = frame\n\t\tend\n\t\tlocal flying = elapsed >= T.Charge and elapsed < impactAt\n\t\ttail:beamsOn(flying)\n\t\tif flying then\n\t\t\ttail:stretch(position, position - heading * (14 + 40 * along))\n\t\tend\n\t\tcometLight.Brightness = if elapsed < impactAt then 0.3 + 0.7 * swell else 0\n\t\tlocal age = elapsed - impactAt\n\t\tcraterLight.Brightness = if age >= 0 then 2.5 * math.exp(-age * 5) else 1.2 * Kit.ramp(elapsed, T.Charge, impactAt)\n\t\tlocal beam = age >= 0 and age < 0.14\n\t\tfor _, streak in ipairs(streaks) do streak:beamsOn(beam) end\n\tend, {folder})\n\n\ttimeline.at(0, function()\n\t\tKit.sound(cometHost, SOUND_SWISH, 0.5, 0.5)\n\t\tImpactFX.shake(origin.Position, 0.25, T.Charge, 50)\n\tend)\n\ttimeline.at(T.Charge, function()\n\t\tmount(\"Impact12\", aim, 1.4):burst(1)\n\t\twarning:stream(true)\n\t\tKit.sound(cometHost, SOUND_SWISH, 0.7, 1.1)\n\t\tImpactFX.shake(origin.Position, 0.6, 0.25, 50)\n\tend)\n\ttimeline.at(impactAt, function()\n\t\tcomet:clear()\n\t\tcomet:fade(0)\n\t\thalo:clear()\n\t\tcrackle:clear()\n\t\ttail:clear()\n\t\twarning:stream(false)\n\t\tmount(\"Impact12\", crater, 4.4):burst(1)\n\t\tmount(\"Impact37\", crater, 4):burst(1)\n\t\tmount(\"Impact36\", crater, 4):burst(1)\n\t\tmount(\"Impact45\", crater, 1.3):burst(0.9)\n\t\tPack.bolt(scope, folder, impact, {tint = BOLT, scale = 7, height = 15, width = 26, duration = 0.45})\n\t\tembers = mount(\"LightningSurge\", crater, 3, 50)\n\t\tembers:stream(true)\n\t\tKit.sound(craterHost, SOUND_BOOM, 0.9, 0.9)\n\t\tKit.sound(craterHost, SOUND_HIT, 0.5, 0.8)\n\t\tImpactFX.hit(impact + normal * 3, {tint = CYAN, pattern = \"triple\", shake = 2.6, shakeDuration = 0.7, punch = 9, radius = 100})\n\tend)\n\tfor i = 1, T.Pulses do\n\t\ttimeline.at(Plan.pulseAt(i), function()\n\t\t\tmount(\"Impact36\", crater, 3):burst(0.9)\n\t\t\tmount(\"Impact12\", crater, 1.5):burst(0.7)\n\t\t\tPack.bolt(scope, folder, impact, {tint = BOLT, scale = 4.5, height = 10, width = 24, duration = 0.22})\n\t\t\tKit.sound(craterHost, SOUND_HIT, 0.35, 0.6 + i * 0.1)\n\t\t\tImpactFX.shake(impact, 0.8, 0.2, 60)\n\t\tend)\n\tend\n\ttimeline.at(Plan.pulseAt(T.Pulses) + 0.25, function()\n\t\tif embers then embers:stream(false) end\n\tend)\n\treturn true\nend\n\nreturn VFX\n"},
{path="ReplicatedStorage/Shared/Abilities/VFX/StarterVFX",class="ModuleScript",source="local ImportedAudio = require(game:GetService(\"ReplicatedStorage\").Shared.Audio.DownloadedSounds)\nlocal RS=game:GetService(\"ReplicatedStorage\")\nlocal RunService=game:GetService(\"RunService\")\nlocal Content=game:GetService(\"ContentProvider\")\nlocal Plan=require(script.Parent.Parent.StarterPlan)\nlocal Library=require(script.Parent.StarterParticles)\nlocal Base=require(script.Parent.CataclysmParticles)\nlocal Pack=require(script.Parent.PackAssembly)\nlocal ImpactFX=require(script.Parent.ImpactFX)\nlocal ReferenceVFX=require(script.Parent.ReferenceVFX)\nlocal Remotes=require(RS.Shared.Net.Remotes)\nlocal VFX={}\nlocal shots={}\nlocal listening,preloaded=false,false\nlocal FIRE=Color3.fromRGB(255,123,34)\nlocal GOLD=Color3.fromRGB(255,221,142)\nlocal WATER=Color3.fromRGB(59,184,255)\nlocal FOAM=Color3.fromRGB(191,246,255)\nlocal WIND=Color3.fromRGB(211,255,235)\nlocal ECHO=Color3.fromRGB(133,194,255)\nlocal EARTH=Color3.fromRGB(145,111,73)\nlocal function ns(a,b) return NumberSequence.new(a,b) end\nlocal function host(parent,name,position,direction)\n\tlocal p=Instance.new(\"Part\")\n\tp.Name=name;p.Size=Vector3.one*.1;p.Transparency=1\n\tp.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.CastShadow=false\n\tp.CFrame=if direction then CFrame.lookAt(position,position+direction) else CFrame.new(position)\n\tp.Parent=parent\n\treturn p\nend\nlocal function emitter(kind,parent,props)\n\tlocal data=Library[kind] or Base[kind]\n\tlocal p=Instance.new(\"ParticleEmitter\")\n\tp.Name=kind;p.Texture=data.Texture;p.FlipbookLayout=data.FlipbookLayout\n\tfor key,value in pairs(data) do p[key]=value end\n\tp.Enabled=false;p.Rate=0;p.TimeScale=1;p.ZOffset=0\n\tfor key,value in pairs(props or {}) do p[key]=value end\n\tp.Parent=parent\n\treturn p\nend\nlocal function burst(kind,parent,count,props)\n\tlocal p=emitter(kind,parent,props);p:Emit(count);return p\nend\nlocal function sound(parent,id,volume,pitch)\n\tlocal s=Instance.new(\"Sound\")\n\ts.SoundId=id;s.Volume=volume;s.PlaybackSpeed=pitch or 1\n\ts.RollOffMinDistance=6;s.RollOffMaxDistance=100;s.Parent=parent;s:Play()\nend\nlocal function attach(parent,position)\n\tlocal a=Instance.new(\"Attachment\");a.Position=position or Vector3.zero;a.Parent=parent;return a\nend\nlocal function ring(parent,color,from,to,lifetime)\n\treturn burst(\"PressureRing\",parent,1,{\n\t\tColor=ColorSequence.new(color),Size=ns(from,to),Lifetime=NumberRange.new(lifetime),\n\t\tSpeed=NumberRange.new(.001),SpreadAngle=Vector2.zero,Drag=0,Squash=NumberSequence.new(0),\n\t\tEmissionDirection=Enum.NormalId.Front,Orientation=Enum.ParticleOrientation.VelocityPerpendicular,\n\t\tTransparency=ns(.15,1),LightEmission=.7,Brightness=1.2,\n\t})\nend\nfunction VFX.preload()\n\tReferenceVFX.preload()\n\tif not listening and RunService:IsRunning() and RunService:IsClient() then\n\t\tlistening=true\n\t\tRemotes.wait(\"AbilityImpact\").OnClientEvent:Connect(function(payload)\n\t\t\tif type(payload)==\"table\" and type(payload.id)==\"string\" and typeof(payload.position)==\"Vector3\" then\n\t\t\t\tlocal receive=shots[payload.id];if receive then receive(payload) end\n\t\t\tend\n\t\tend)\n\tend\n\tPack.preload()\n\tif preloaded then return end\n\tpreloaded=true\n\ttask.spawn(function()\n\t\tlocal assets={}\n\t\tfor _,data in pairs(Library) do table.insert(assets,data.Texture) end\n\t\tfor _,kind in ipairs({\"Flame\",\"FireballA\",\"Smoke\",\"Embers\",\"Flash\",\"PressureRing\",\"Rock\",\"Streaks\"}) do table.insert(assets,Base[kind].Texture) end\n\t\tlocal sounds={}\n\t\tfor _,id in ipairs({ImportedAudio.ability_whoosh,ImportedAudio.ability_impact_heavy,\"rbxasset://sounds/impact_water.mp3\"}) do\n\t\t\tlocal s=Instance.new(\"Sound\");s.SoundId=id;table.insert(sounds,s);table.insert(assets,s)\n\t\tend\n\t\tpcall(function() Content:PreloadAsync(assets,function(asset,status)\n\t\t\tif status~=Enum.AssetFetchStatus.Success then warn(\"[StarterVFX] Asset unavailable: \"..asset) end\n\t\tend) end)\n\t\tfor _,s in ipairs(sounds) do s:Destroy() end\n\tend)\nend\nfunction VFX.duration() return Plan.duration() end\n\n-- Fireball shares Blighted Fireball's particle body in ReferenceVFX;\n-- its original authored explosion and tint remain here.\nlocal MUZZLE=3.5\nlocal Shots={\n\tFireball={\n\t\ttint={deep=Color3.fromRGB(150,12,3),main=Color3.fromRGB(255,58,8),hot=Color3.fromRGB(255,142,44)},\n\t},\n\tWaterBlade={\n\t\ttint={deep=Color3.fromRGB(8,74,190),main=WATER,hot=FOAM},\n\t\tbody={\"CrescentSlash\",1,90},bodyPart=\"Crescent Slash\",meshTint={deep=Color3.fromRGB(6,58,170),main=Color3.fromRGB(16,112,235),hot=FOAM},\n\t\t-- The arc cuts forward, tipped up and rolled so its face stays to the camera;\n\t\t-- lying flat it turns edge-on from behind the caster.\n\t\tlie=CFrame.Angles(math.rad(58),0,math.rad(-16))*CFrame.fromMatrix(Vector3.zero,Vector3.yAxis,-Vector3.xAxis,Vector3.zAxis),\n\t\tglow={\"Droplets69\",.55,40},tail={\"KiBlast2\",.09},length=15,\n\t\tmuzzle={\"SlashImpact1\",1.2,1},light=WATER,launch=1.5,\n\t},\n}\n\nlocal function fireBlast(scope,folder,point,direction,tint,silent)\n\tlocal frame=CFrame.lookAt(point,point+direction)\n\tlocal function mount(name,scale,budget,extra)\n\t\tlocal options={cframe=frame,scale=scale,budget=budget,tint=extra or tint,brightness=1.6}\n\t\treturn Pack.mount(scope,folder,name,options)\n\tend\n\tlocal p=host(folder,\"Impact\",point,direction)\n\tlocal light=Instance.new(\"PointLight\");light.Color=FIRE;light.Brightness=2.5;light.Range=32;light.Shadows=false;light.Parent=p\n\tscope:tween(light,TweenInfo.new(.7,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Brightness=0})\n\t-- First beat: flame spikes inside a swirling rim of fire.\n\tmount(\"Impact45\",1.1):burst(1)\n\tmount(\"Impact1\",1.4):burst(.9)\n\tmount(\"FireVFX5\",.95):burst(.45)\n\tif not silent then sound(p,ImportedAudio.ability_impact_heavy,.6,1.25) end\n\tImpactFX.shake(point,1.4,.4,70);ImpactFX.punch(point,4,.35,70)\n\t-- Second beat: the fireball itself rolls out, then breaks into embers and smoke.\n\tscope:delay(.17,function()\n\t\tmount(\"Impact41\",2.2):burst(1)\n\t\tmount(\"FireVFX8\",1.8):burst(1)\n\t\tmount(\"Impact20\",1.15):burst(1)\n\t\tPack.mount(scope,folder,\"Rocks\",{cframe=CFrame.new(point),scale=.5,tint=tint,brightness=2}):burst(1)\n\t\tif not silent then sound(p,ImportedAudio.ability_impact_heavy,.5,.8) end\n\tend)\n\tlocal smoke=Color3.fromRGB(22,14,14)\n\tscope:delay(.34,function()\n\t\tPack.mount(scope,folder,\"SmokePuff\",{cframe=frame,scale=2.2,tint={deep=smoke,main=smoke,hot=Color3.fromRGB(60,34,28)}}):burst(1.4)\n\t\tlocal linger=mount(\"FireVFX6\",2.4,120)\n\t\tlinger:stream(true)\n\t\tscope:delay(.45,function() linger:stream(false) end)\n\tend)\nend\n\nlocal function waterSplash(scope,folder,point,direction,tint)\n\tlocal frame=CFrame.lookAt(point,point+direction)\n\tlocal p=host(folder,\"Impact\",point,direction)\n\tlocal function mount(name,scale,budget)\n\t\treturn Pack.mount(scope,folder,name,{cframe=frame,scale=scale,budget=budget,tint=tint,brightness=2})\n\tend\n\tmount(\"SlashImpact1\",2.6):burst(1)\n\tmount(\"SlashImpact3\",2.2):burst(1)\n\tmount(\"Impact36\",2.4):burst(1)\n\tmount(\"Droplets69\",.8):burst(1)\n\tlocal splash=Pack.mount(scope,folder,\"IceSplash\",{cframe=CFrame.new(point),scale=.16,tint=tint,brightness=2,visible=true})\n\tsplash:burst(1)\n\tsplash:grow(scope,.3,.45)\n\tlocal drops=mount(\"Droplets69\",.55,36)\n\tdrops:stream(true)\n\tscope:delay(.3,function() drops:stream(false) end)\n\tsound(p,\"rbxasset://sounds/impact_water.mp3\",.6,1.3)\n\tImpactFX.shake(point,.9,.3,60);ImpactFX.punch(point,2,.3,60)\nend\n\nlocal function projectile(payload,scope,folder,age)\n\tlocal tuning=Plan[payload.ability]\n\tlocal shot=Shots[payload.ability]\n\tlocal origin=payload.origin.Position\n\tlocal direction=payload.direction\n\tlocal frame=CFrame.lookAt(origin,origin+direction)\n\tlocal p=host(folder,\"Projectile\",origin,direction)\n\tlocal function part(entry,extra)\n\t\tlocal options={cframe=frame,scale=entry[2],budget=entry[3],tint=shot.tint,brightness=2}\n\t\tfor key,value in pairs(extra or {}) do options[key]=value end\n\t\treturn Pack.mount(scope,folder,entry[1],options)\n\tend\n\tlocal body=part(shot.body,{visible=true,locked=true,meshTint=shot.meshTint})\n\tif shot.bodyPart then body:alignPart(shot.bodyPart,shot.lie) end\n\tif shot.head then body:trailBeams(shot.head) end\n\tif shot.slim then body:slim(shot.slim) end\n\tlocal glow,tail=part(shot.glow),part(shot.tail)\n\ttail:taper(.2)\n\t-- The body gathers at the muzzle through the windup, small, then swells.\n\tbody:rescale(shot.body[2]*.35)\n\tbody:stream(true)\n\tlocal function place(at)\n\t\tlocal to=CFrame.lookAt(at,at+direction)\n\t\tbody:place(to)\n\t\tglow:place(to)\n\tend\n\tplace(origin+direction*MUZZLE)\n\tlocal light=Instance.new(\"PointLight\");light.Color=shot.light;light.Brightness=2;light.Range=18;light.Parent=p\n\tlocal stopped,launched=false,false\n\tlocal function stop(packet)\n\t\tif stopped then return end\n\t\tstopped=true;p.Position=packet.position\n\t\tbody:clear();body:fade(0);glow:stream(false);tail:clear()\n\t\tlight.Enabled=false\n\t\tif not packet.cancelled then\n\t\t\tlocal normal=packet.normal or -direction\n\t\t\twaterSplash(scope,folder,packet.position,normal,shot.tint)\n\t\tend\n\t\t-- The shot is over: its server cast may still be open, its visuals need not be.\n\t\tscope:delay(2.2,function() scope:destroy() end)\n\tend\n\tif payload.id then shots[payload.id]=stop;scope:add(function() shots[payload.id]=nil end) end\n\tlocal function update()\n\t\tif stopped then return end\n\t\tlocal elapsed=workspace:GetServerTimeNow()-payload.startedAt\n\t\tlocal travel=math.clamp((elapsed-tuning.windup)*tuning.speed,0,tuning.range)\n\t\tlocal at=origin+direction*(travel+math.min(MUZZLE,tuning.range-travel))\n\t\tp.CFrame=CFrame.lookAt(at,at+direction)\n\t\tif not launched then body:rescale(shot.body[2]*(.35+.65*math.clamp(elapsed/tuning.windup,0,1))) end\n\t\tplace(at)\n\t\tif elapsed>=tuning.windup and not launched then\n\t\t\tlaunched=true\n\t\t\tbody:rescale(shot.body[2])\n\t\t\tglow:stream(true);tail:beamsOn(true);body:beamsOn(true)\n\t\t\tPack.mount(scope,folder,shot.muzzle[1],{cframe=frame,scale=shot.muzzle[2],tint=shot.tint,brightness=2}):burst(shot.muzzle[3])\n\t\t\tsound(p,ImportedAudio.ability_whoosh,.3,shot.launch)\n\t\tend\n\t\tif launched then tail:stretch(at,at-direction*math.min(travel,shot.length)) end\n\t\tif elapsed>tuning.windup+tuning.range/tuning.speed+.3 then stop({position=p.Position}) end\n\t\tlocal caster=payload.caster\n\t\tif caster and (not caster.Character or not caster.Character:FindFirstChildOfClass(\"Humanoid\") or caster.Character:FindFirstChildOfClass(\"Humanoid\").Health<=0) then stop({position=p.Position,cancelled=true}) end\n\tend\n\tupdate();scope:add(RunService.Heartbeat:Connect(update))\nend\n\nlocal function wind(payload,scope,folder,at)\n\tlocal origin=payload.origin.Position\n\tlocal direction=payload.direction\n\tlocal root=host(folder,\"WindGather\",origin+direction*2,direction)\n\tburst(\"Wind\",root,1,{Size=ns(4,1),Lifetime=NumberRange.new(.16),Speed=NumberRange.new(.001),SpreadAngle=Vector2.zero,EmissionDirection=Enum.NormalId.Front,Color=ColorSequence.new(WIND),Transparency=ns(.7,.2)})\n\tat(Plan.WindBurst.windup,function()\n\t\tsound(root,ImportedAudio.ability_whoosh,.5,.8)\n\t\t-- Fixed emitter stations and widening arcs read as a short shove, not a ball.\n\t\tfor i=1,3 do\n\t\t\tlocal p=host(folder,\"WindFan\",origin+direction*(2+i*3),direction)\n\t\t\tring(p,WIND,2+i,8+i*4,.3+i*.025)\n\t\t\tburst(\"Wind\",p,2,{Size=ns(3+i,10+i*4),Lifetime=NumberRange.new(.35,.45),Speed=NumberRange.new(.01),SpreadAngle=Vector2.zero,EmissionDirection=Enum.NormalId.Front,Color=ColorSequence.new(WIND),LightEmission=.55,Brightness=1.4,Transparency=ns(.18,1),RotSpeed=NumberRange.new(-55,55)})\n\t\tend\n\t\tburst(\"WindMist\",root,8,{Size=ns(3,7),Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(15,30),EmissionDirection=Enum.NormalId.Front,SpreadAngle=Vector2.new(25,55),Color=ColorSequence.new(WIND),Transparency=ns(.65,1),LightEmission=.2})\n\t\tburst(\"Streaks\",root,20,{Size=ns(1.3,0),Lifetime=NumberRange.new(.12,.3),Speed=NumberRange.new(35,55),EmissionDirection=Enum.NormalId.Front,SpreadAngle=Vector2.new(15,45),Color=ColorSequence.new(WIND),LockedToPart=false,Brightness=1.5})\n\tend)\nend\n\nlocal function echo(payload,scope,folder,at)\n\tlocal from=host(folder,\"Departure\",payload.origin.Position,payload.direction)\n\tlocal to=host(folder,\"Arrival\",payload.destination,payload.direction)\n\tlocal a,b=attach(from),attach(to)\n\tlocal beam=Instance.new(\"Beam\")\n\tbeam.Name=\"EchoRibbon\";beam.Attachment0=a;beam.Attachment1=b;beam.FaceCamera=true\n\tbeam.Texture=Library.Slash.Texture;beam.TextureSpeed=2;beam.TextureLength=7\n\tbeam.Width0=2.4;beam.Width1=.3;beam.Color=ColorSequence.new(ECHO,FOAM);beam.LightEmission=.8\n\tbeam.Transparency=NumberSequence.new(.2);beam.Parent=from\n\tburst(\"Echo\",from,2,{Size=ns(7,12),Lifetime=NumberRange.new(.3),Speed=NumberRange.new(.001),Color=ColorSequence.new(ECHO),LightEmission=.6,Brightness=1.3})\n\tring(from,ECHO,2,9,.3)\n\tfor i=1,5 do\n\t\tlocal p=host(folder,\"EchoTrace\",payload.origin.Position:Lerp(payload.destination,i/6),payload.direction)\n\t\tburst(\"WindMist\",p,1,{Size=ns(3,5),Lifetime=NumberRange.new(.18+i*.025),Speed=NumberRange.new(.001),Color=ColorSequence.new(ECHO),Transparency=ns(.55,1),LightEmission=.6})\n\tend\n\tat(.08,function()\n\t\tburst(\"Echo\",to,2,{Size=ns(4,10),Lifetime=NumberRange.new(.35),Speed=NumberRange.new(.001),Color=ColorSequence.new(FOAM,ECHO),LightEmission=.7})\n\t\tring(to,FOAM,2,9,.35)\n\t\tburst(\"Embers\",to,16,{Size=ns(.25,0),Lifetime=NumberRange.new(.3,.6),Speed=NumberRange.new(5,15),Color=ColorSequence.new(FOAM,ECHO),LightEmission=1})\n\tend)\n\tsound(from,ImportedAudio.ability_whoosh,.35,1.8)\n\tscope:add(RunService.Heartbeat:Connect(function()\n\t\tbeam.Transparency=NumberSequence.new(math.clamp(.2+(workspace:GetServerTimeNow()-payload.startedAt)/.35,0,1))\n\tend))\nend\n\nlocal function wall(payload,scope,folder,at)\n\tlocal movers={}\n\tfor i,r in ipairs(payload.blocks or {}) do\n\t\tlocal p=host(folder,\"EarthWake\",r.from)\n\t\tlocal smoke=emitter(\"Smoke\",p,{Rate=12,Size=ns(1.3,3),Lifetime=NumberRange.new(.25,.5),Speed=NumberRange.new(1,3),Color=ColorSequence.new(EARTH),LightEmission=.05,Transparency=ns(.6,1)})\n\t\tsmoke.Enabled=true\n\t\tburst(\"Rock\",p,5,{Size=ns(.3,0),Lifetime=NumberRange.new(.25,.45),Speed=NumberRange.new(5,12),Color=ColorSequence.new(EARTH),Acceleration=Vector3.new(0,-25,0)})\n\t\ttable.insert(movers,{host=p,smoke=smoke,record=r,index=i})\n\tend\n\tscope:add(RunService.Heartbeat:Connect(function()\n\t\tlocal alpha=(workspace:GetServerTimeNow()-payload.startedAt)/Plan.BlockWall.travel\n\t\tfor _,v in ipairs(movers) do\n\t\t\tv.host.Position=Plan.wallPosition(v.record.from,v.record.to,alpha,v.index)\n\t\t\tif alpha>=1 then v.smoke.Enabled=false end\n\t\tend\n\tend))\n\tat(Plan.BlockWall.travel,function()\n\t\tfor _,v in ipairs(movers) do\n\t\t\tburst(\"Smoke\",v.host,3,{Size=ns(2,4),Lifetime=NumberRange.new(.35,.6),Speed=NumberRange.new(3,8),Color=ColorSequence.new(EARTH),Transparency=ns(.5,1),LightEmission=.1})\n\t\tend\n\t\tif movers[1] then sound(movers[1].host,ImportedAudio.ability_impact_heavy,.15,1.1) end\n\tend)\nend\n\nfunction VFX.play(payload,scope)\n\tif typeof(payload.origin)~=\"CFrame\" or type(payload.startedAt)~=\"number\" then return false end\n\tlocal age=workspace:GetServerTimeNow()-payload.startedAt\n\tif age>=Plan.duration() then return false end\n\tVFX.preload()\n\tif payload.ability==\"Fireball\" then\n\t\treturn ReferenceVFX.play(payload,scope,function(impactScope,impactFolder,point,normal)\n\t\t\tfireBlast(impactScope,impactFolder,point,normal,Shots.Fireball.tint,true)\n\t\tend)\n\tend\n\tlocal folder=scope:add(Instance.new(\"Folder\"));folder.Name=payload.ability..\"VFX\";folder.Parent=workspace\n\tlocal function at(t,callback)\n\t\tif age>t+.3 then return end\n\t\tscope:delay(math.max(0,t-age),callback)\n\tend\n\tif payload.ability==\"WaterBlade\" then projectile(payload,scope,folder,age)\n\telseif payload.ability==\"WindBurst\" then wind(payload,scope,folder,at)\n\telseif payload.ability==\"EchoStep\" then echo(payload,scope,folder,at)\n\telseif payload.ability==\"BlockWall\" then wall(payload,scope,folder,at)\n\telse return false end\n\tscope:delay(math.max(0,Plan.duration()-age),function() scope:destroy() end)\n\treturn true\nend\nreturn VFX\n"},
{path="StarterPlayer/StarterPlayerScripts/DropFlight",class="LocalScript",source="--[[\n\tDropFlight\n\n\tA drop you walked up to, flying to you: a small cube on a curve with a\n\ttrail behind it, coloured by the item's rarity.\n\n\t\tGroundDrops, on a pickup  ->  EnemyDropFlight(from, item, amount)\n\t\t                              ...and the item lands in the bag\n\t\t                              EnemyConfig.DropFlightSeconds later\n\n\t(The remote keeps its old name from when enemy loot flew straight from the\n\tcorpse. All loot lands on the ground now, enemy loot included.)\n\n\tThe floating cube GroundDropClient draws is DropConfig.Size too, and `from`\n\tis the middle of its bob, and the server removes it in the same step it\n\tsends this - so the cube seems to lift off and fly rather than vanish and\n\treappear. Purely a picture: the server has already decided the pickup, and\n\tgrants it whether or not this ever draws.\n\n\tTHE ARRIVAL AND THE LINE ARE THE SAME MOMENT, WITHOUT BEING TOLD SO\n\n\tThis does not write the \"+1 Oak Log\" line. The server holds the grant back\n\tfor exactly the flight time, so the inventory changes as the cube lands and\n\tStarterPlayerScripts.ItemFeedback writes the line off that, the same way it\n\twrites every other one. Two things agreeing because they read one constant,\n\trather than three messages that have to arrive in order.\n\n\tA QUADRATIC BEZIER, AND WHY IT IS RE-EVALUATED EVERY FRAME\n\n\tThe target moves. A curve baked at launch would fly to where the player was\n\tstanding half a second ago and stop in mid air, which is exactly what a\n\tpickup must never do - the whole point of the arc is that it ends ON you.\n\tSo the endpoint is read from the character each frame and the curve is\n\trebuilt around it; only the START and the lift are fixed.\n\n\tThe control point is above the midpoint, so the cube leaves the corpse\n\tupward and comes down onto the player. Lift scales with distance, because a\n\tfixed height reads as a mortar shell across a room and as a flat line across\n\ta field.\n\n\tIT IS DRAWN, NOT SIMULATED. An anchored part moved by hand: no physics, no\n\tcollisions, nothing to tunnel through terrain or shove anybody. It cannot\n\tmiss and it cannot get stuck, which are the only two things a pickup\n\tanimation has to promise.\n]]\n\nlocal Players = game:GetService(\"Players\")\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\nlocal RunService = game:GetService(\"RunService\")\nlocal Debris = game:GetService(\"Debris\")\n\nlocal ItemDefinitions = require(ReplicatedStorage:WaitForChild(\"ItemDefinitions\"))\n\nlocal Shared = ReplicatedStorage:WaitForChild(\"Shared\")\nlocal Theme = require(Shared:WaitForChild(\"UI\"):WaitForChild(\"Theme\"))\nlocal Remotes = require(Shared:WaitForChild(\"Net\"):WaitForChild(\"Remotes\"))\nlocal EnemyConfig = require(Shared:WaitForChild(\"Enemies\"):WaitForChild(\"EnemyConfig\"))\nlocal Sounds = require(Shared:WaitForChild(\"Audio\"):WaitForChild(\"Sounds\"))\nlocal WorldFeedback = require(Shared.UI:WaitForChild(\"WorldFeedback\"))\nlocal DropConfig = require(Shared:WaitForChild(\"Inventory\"):WaitForChild(\"DropConfig\"))\n\nlocal DropFlight = Remotes.wait(\"EnemyDropFlight\")\n\nlocal player = Players.LocalPlayer\n\nlocal FLIGHT = EnemyConfig.DropFlightSeconds\n\n-- The same cube that was floating on the ground.\nlocal CUBE_SIZE = DropConfig.Size\n\n-- The small puff of the item's colour where the cube is caught.\nlocal CATCH_SHELL_SIZE = 1.6\n\n-- How high the curve bulges, as a fraction of how far it has to travel, and\n-- the floor under that so a drop at your feet still arcs.\nlocal LIFT_FRACTION = 0.32\nlocal LIFT_MINIMUM = 3\n\n-- Where on the body it lands. Chest height rather than the feet: it reads as\n-- being collected rather than as landing on the floor next to you.\nlocal CATCH_HEIGHT = 2\n\n--[[\n\tThe trail. Wide at the cube and pinched to nothing behind it, which is what\n\tmakes a short trail read as motion rather than as a stick being carried.\n]]\nlocal TRAIL_LIFETIME = 0.35\nlocal TRAIL_WIDTH = 0.9\n\n-- More than could plausibly be in the air at once from honest play, and a hard\n-- stop on a server that decided to send a thousand.\nlocal MAX_IN_FLIGHT = 24\n\nlocal inFlight = 0\n\nlocal function rarityColor(itemName: string): Color3\n\tlocal definition = ItemDefinitions[itemName]\n\treturn Theme.rarityColor(definition and definition.rarity)\nend\n\n--[[\n\tWhere the cube is heading, right now.\n\n\tNil once there is nobody to fly to - a respawn mid-flight - which is what\n\tends the flight early rather than sending the cube to the origin.\n]]\nlocal function catchPoint(): Vector3?\n\tlocal character = player.Character\n\tlocal root = character and character:FindFirstChild(\"HumanoidRootPart\")\n\n\tif not root then\n\t\treturn nil\n\tend\n\n\treturn root.Position + Vector3.new(0, CATCH_HEIGHT, 0)\nend\n\nlocal function build(color: Color3): Part\n\tlocal cube = Instance.new(\"Part\")\n\tcube.Name = \"Drop\"\n\tcube.Size = Vector3.one * CUBE_SIZE\n\tcube.Color = color\n\tcube.Material = Enum.Material.Neon\n\tcube.Anchored = true\n\tcube.CanCollide = false\n\tcube.CanQuery = false\n\tcube.CanTouch = false\n\tcube.CastShadow = false\n\n\t--[[\n\t\tTwo attachments a little apart across the cube, because a Trail needs a\n\t\tWIDTH and takes it from the gap between them. A single point would\n\t\tproduce nothing at all - the commonest way a trail silently does not\n\t\tappear.\n\t]]\n\tlocal top = Instance.new(\"Attachment\")\n\ttop.Position = Vector3.new(0, TRAIL_WIDTH * 0.5, 0)\n\ttop.Parent = cube\n\n\tlocal bottom = Instance.new(\"Attachment\")\n\tbottom.Position = Vector3.new(0, -TRAIL_WIDTH * 0.5, 0)\n\tbottom.Parent = cube\n\n\tlocal trail = Instance.new(\"Trail\")\n\ttrail.Attachment0 = top\n\ttrail.Attachment1 = bottom\n\ttrail.Lifetime = TRAIL_LIFETIME\n\ttrail.LightEmission = 1\n\ttrail.LightInfluence = 0\n\ttrail.FaceCamera = true\n\n\t-- The rarity colour, fading out along its length rather than stopping dead.\n\ttrail.Color = ColorSequence.new(color)\n\ttrail.Transparency = NumberSequence.new({\n\t\tNumberSequenceKeypoint.new(0, 0.15),\n\t\tNumberSequenceKeypoint.new(1, 1),\n\t})\n\ttrail.Parent = cube\n\n\treturn cube\nend\n\n--[[\n\tOne flight, from a corpse to whoever is being flown to.\n\n\tIts own coroutine per drop rather than one loop over a list: a kill drops\n\tone or two things, they are gone in half a second, and a shared scheduler\n\twould be more machinery than the thing it schedules.\n]]\nlocal function fly(from: Vector3, itemName: string, color: Color3)\n\tlocal cube = build(color)\n\tcube.CFrame = CFrame.new(from)\n\tcube.Parent = workspace\n\n\t-- The backstop. Whatever happens to the loop below, the part goes.\n\tDebris:AddItem(cube, FLIGHT + 1)\n\n\tinFlight += 1\n\n\tlocal elapsed = 0\n\tlocal spin = Vector3.new(math.random(), math.random(), math.random()).Unit * 9\n\n\tlocal connection\n\tconnection = RunService.RenderStepped:Connect(function(deltaTime)\n\t\telapsed += deltaTime\n\n\t\tlocal target = catchPoint()\n\n\t\tif not target or elapsed >= FLIGHT then\n\t\t\tconnection:Disconnect()\n\t\t\tinFlight -= 1\n\t\t\tcube:Destroy()\n\n\t\t\t-- Only if it actually arrived. A flight cut short by a respawn has\n\t\t\t-- nothing to announce, and the item is still on its way to the bag.\n\t\t\tif target then\n\t\t\t\tSounds.play(\"loot.pickup\")\n\t\t\t\tWorldFeedback.impact(target, color, CATCH_SHELL_SIZE, \"Ball\", 0.4)\n\t\t\tend\n\t\t\treturn\n\t\tend\n\n\t\tlocal alpha = elapsed / FLIGHT\n\n\t\t--[[\n\t\t\tThe control point, rebuilt around wherever the player is NOW.\n\n\t\t\tAbove the midpoint by a fraction of the distance still being\n\t\t\tcovered, so an item dropped across a field arcs high and one\n\t\t\tdropped at your feet hops.\n\t\t]]\n\t\tlocal span = (target - from).Magnitude\n\t\tlocal lift = math.max(LIFT_MINIMUM, span * LIFT_FRACTION)\n\t\tlocal control = (from + target) * 0.5 + Vector3.new(0, lift, 0)\n\n\t\t-- Quadratic bezier: lerp the two legs, then lerp between those.\n\t\tlocal inverse = 1 - alpha\n\t\tlocal position = from * (inverse * inverse)\n\t\t\t+ control * (2 * inverse * alpha)\n\t\t\t+ target * (alpha * alpha)\n\n\t\tcube.CFrame = CFrame.new(position)\n\t\t\t* CFrame.Angles(spin.X * elapsed, spin.Y * elapsed, spin.Z * elapsed)\n\tend)\nend\n\n--[[\n\t`amount` is deliberately not used.\n\n\tIt is on the wire because the flight and the grant are the same event and\n\tsplitting them would leave the message unable to describe itself - but what\n\tthe player is told they got comes from the bag changing, not from here. One\n\tcube whatever the number, which is also what stops a stack of sixty-four\n\tturning into sixty-four projectiles.\n]]\nDropFlight.OnClientEvent:Connect(function(from, itemName, _amount)\n\tif typeof(from) ~= \"Vector3\" or type(itemName) ~= \"string\" or itemName == \"\" then\n\t\treturn\n\tend\n\n\tif inFlight >= MAX_IN_FLIGHT then\n\t\treturn\n\tend\n\n\tfly(from, itemName, rarityColor(itemName))\nend)\n"},
{path="ReplicatedStorage/Shared/Audio/DownloadedSounds",class="ModuleScript",source="-- Private group uploads: saile stone studios (275555347). See assets/audio/published.json.\nreturn {\n\tability_charge = \"rbxassetid://80469422281117\",\n\tability_ice_break = \"rbxassetid://100027213660268\",\n\tability_impact_heavy = \"rbxassetid://75298384523205\",\n\tability_lightning = \"rbxassetid://127370356416000\",\n\tability_magic_cast = \"rbxassetid://130227553369088\",\n\tability_magic_glow = \"rbxassetid://113620206226997\",\n\tability_magic_poof = \"rbxassetid://110759823118127\",\n\tability_portal = \"rbxassetid://71057281988091\",\n\tability_shield_off = \"rbxassetid://76077051791587\",\n\tability_shield_on = \"rbxassetid://124877493276727\",\n\tability_whoosh = \"rbxassetid://139339817665085\",\n\tambience_fire = \"rbxassetid://138595839171422\",\n\tambience_night = \"rbxassetid://98492522972935\",\n\tambience_rain_heavy = \"rbxassetid://89541543479502\",\n\tambience_rain_light = \"rbxassetid://106908818229091\",\n\tambience_sea = \"rbxassetid://127640388678637\",\n\tambience_snow = \"rbxassetid://118921273657411\",\n\tambience_thunderstorm = \"rbxassetid://73857507440986\",\n\tambience_waterfall = \"rbxassetid://109920952255959\",\n\tambience_wind = \"rbxassetid://96075055892597\",\n\tcraft_success = \"rbxassetid://125419495288005\",\n\tloot_pickup = \"rbxassetid://80088927282585\",\n\tui_click = \"rbxassetid://116350521860867\",\n\tui_close = \"rbxassetid://74195717999229\",\n\tui_denied = \"rbxassetid://129559530621871\",\n\tui_hover = \"rbxassetid://112826496895979\",\n\tui_notify = \"rbxassetid://75501362722952\",\n\tui_open = \"rbxassetid://105535261809859\",\n\tui_tab = \"rbxassetid://122341039414321\",\n}\n"},
{path="ReplicatedStorage/Shared/Audio/SoundConfig",class="ModuleScript",source="-- Sound routing for Blockbound. Imported audio is owned by saile stone studios.\n-- Legacy built-ins remain for material sounds not covered by the download.\n\nlocal SoundConfig = {}\n\n-- ---------------------------------------------------------------------------\n-- Palette\n-- ---------------------------------------------------------------------------\n\nlocal Palette = {\n\t-- A soft, short interface blip. Used for hovers and light interactions.\n\tUiSoft = \"rbxassetid://421058925\",\n\n\t-- The heavier click this project has always used for committing actions.\n\tUiClick = \"rbxassetid://6895079853\",\n\n\t-- A dry, short tap. The workhorse for block impacts: pitched right down it\n\t-- is stone, up it is wood.\n\tTap = \"rbxasset://sounds/action_footsteps_plastic.mp3\",\n\n\t-- Airy and granular. Sand and snow.\n\tGranular = \"rbxasset://sounds/action_swim.mp3\",\n\n\t-- A short scrape with a tail, for a block finally giving way.\n\tCrumble = \"rbxasset://sounds/action_get_up.mp3\",\n\n\t-- Wet, soft. Snow and water.\n\tSoft = \"rbxasset://sounds/impact_water.mp3\",\n\n\t-- A clean metallic ping. Ore, and crafting confirmations.\n\tChime = \"rbxasset://sounds/electronicpingshort.wav\",\n\n\t-- A low body thump. Refusals, and the bottom end of heavy sounds.\n\tThump = \"rbxasset://sounds/bass.wav\",\n\n\t-- Mechanical clicks, for panels and placement.\n\tClack = \"rbxasset://sounds/switch3.wav\",\n\tClackLow = \"rbxasset://sounds/switch.wav\",\n\n\t-- Air moving. Tool swings.\n\tSwoosh = \"rbxasset://sounds/swoosh.wav\",\n}\n\nSoundConfig.Palette = Palette\n\n-- ---------------------------------------------------------------------------\n-- Library\n-- ---------------------------------------------------------------------------\n--\n--   id         asset to play\n--   volume     0-1\n--   pitch      base PlaybackSpeed\n--   pitchVary  +/- random jitter applied per play\n--   throttle   minimum seconds between two plays of this key\n--   layer      { id, volume, pitch, pitchVary } played simultaneously\n\nSoundConfig.Sounds = {\n\t-- === UI ===============================================================\n\t-- Hover is the most-repeated sound in the game, so it is quiet, jittered\n\t-- and throttled hard. It should register without ever being noticed.\n\t[\"ui.hover\"] = { id = Palette.UiSoft, volume = 0.12, pitch = 1.35, pitchVary = 0.07, throttle = 0.05 },\n\n\t[\"ui.click\"] = { id = Palette.UiClick, volume = 0.4, pitch = 1.0, pitchVary = 0.04 },\n\t[\"ui.tab\"] = { id = Palette.UiSoft, volume = 0.22, pitch = 1.0, pitchVary = 0.05 },\n\n\t[\"ui.open\"] = {\n\t\tid = Palette.Clack,\n\t\tvolume = 0.3,\n\t\tpitch = 1.1,\n\t\tpitchVary = 0.03,\n\t\tlayer = { id = Palette.UiSoft, volume = 0.16, pitch = 0.9 },\n\t},\n\t[\"ui.close\"] = { id = Palette.ClackLow, volume = 0.26, pitch = 0.92, pitchVary = 0.03 },\n\n\t-- Refusal: a low body thump, no top end. Reads as \"no\" without being shrill.\n\t[\"ui.denied\"] = { id = Palette.Thump, volume = 0.32, pitch = 1.5, pitchVary = 0.03, throttle = 0.12 },\n\n\t-- === Crafting =========================================================\n\t-- Success is a chime over a clack, so it lands as a \"made a thing\" rather\n\t-- than a menu beep.\n\t[\"craft.success\"] = {\n\t\tid = Palette.Chime,\n\t\tvolume = 0.45,\n\t\tpitch = 1.45,\n\t\tpitchVary = 0.04,\n\t\tlayer = { id = Palette.Clack, volume = 0.28, pitch = 0.8 },\n\t},\n\t[\"craft.fail\"] = { id = Palette.Thump, volume = 0.34, pitch = 1.25, pitchVary = 0.03 },\n\n\t-- === Tools ============================================================\n\t[\"tool.swing\"] = { id = Palette.Swoosh, volume = 0.22, pitch = 1.3, pitchVary = 0.14, throttle = 0.08 },\n\t[\"tool.equip\"] = { id = Palette.ClackLow, volume = 0.22, pitch = 1.5, pitchVary = 0.06 },\n\n\t-- === Abilities ========================================================\n\t-- Not from the Palette: these two ids, both volumes and the 0.8-1.2 pitch\n\t-- jitter are the SacredSwords reference's own, created in code by the\n\t-- script under StarterPack.Gate.Event. Deliberately NOT throttled - a cast\n\t-- fires fifteen of each and the overlap is the sound.\n\t--\n\t-- The one number that is this game's rather than the reference's is `range`.\n\t-- The reference leaves rolloff at the engine default, which is effectively\n\t-- global; a barrage that lands eighty studs away should be audible without\n\t-- being audible across the whole world.\n\t[\"ability.sacredrain.portal\"] = {\n\t\tid = \"rbxassetid://137782657646699\",\n\t\tvolume = 1,\n\t\tpitch = 1.0,\n\t\tpitchVary = 0.2,\n\t\trange = 300,\n\t},\n\t[\"ability.sacredrain.impact\"] = {\n\t\tid = \"rbxassetid://105248065965594\",\n\t\tvolume = 2,\n\t\tpitch = 1.0,\n\t\tpitchVary = 0.2,\n\t\trange = 300,\n\t},\n\n\t--[[\n\t\tEclipse: the same two ids, pitched down.\n\n\t\tNot laziness and not a placeholder. There are exactly two ability sounds\n\t\tin this project, both from the reference, and nothing else to point at\n\t\tthat has been heard - so rather than invent ids that might be silence,\n\t\tmight be a cough, and cannot be checked from here, the ability borrows\n\t\tthe ones that are known to load and separates itself with pitch.\n\n\t\tDropping the portal to 0.55 and the impact to 0.62 puts both well below\n\t\tanything Sacred Rain plays, which is what stops the two abilities\n\t\tsounding like the same event; the wide pitchVary on the burst is what\n\t\tstops repeated casts sounding mechanical. Put real ids here when there\n\t\tare real ids to put.\n\t]]\n\t[\"ability.eclipse.charge\"] = {\n\t\tid = \"rbxassetid://137782657646699\",\n\t\tvolume = 1.1,\n\t\tpitch = 0.5,\n\t\tpitchVary = 0.05,\n\t\trange = 320,\n\t},\n\n\t--[[\n\t\tThe burst, layered with a second copy of itself an octave and a half\n\t\tdown.\n\n\t\tTwo things make a sound feel big, and only one of them is volume. The\n\t\tother is having a body under it: the same hit at 0.62 and again at 0.34\n\t\treads as one impact with weight rather than as one impact played loudly,\n\t\tbecause the low copy arrives as pressure rather than as a noise.\n\n\t\tThe range is nearly the whole broadcast radius - an endgame blast that\n\t\tcan be seen from across the map should be audible from there too.\n\t]]\n\t[\"ability.eclipse.burst\"] = {\n\t\tid = \"rbxassetid://105248065965594\",\n\t\tvolume = 3,\n\t\tpitch = 0.62,\n\t\tpitchVary = 0.08,\n\t\trange = 480,\n\t\t-- The layer carries its own range: playLayer defaults to 90 studs, which\n\t\t-- would drop the body off long before the sound it belongs to.\n\t\tlayer = { id = \"rbxassetid://105248065965594\", volume = 2.4, pitch = 0.34, range = 480 },\n\t},\n\n\t-- The second wave, half a second later: the same hit, quieter and lower\n\t-- still, so it reads as the blast settling rather than as another one.\n\t[\"ability.eclipse.aftershock\"] = {\n\t\tid = \"rbxassetid://105248065965594\",\n\t\tvolume = 1.3,\n\t\tpitch = 0.42,\n\t\tpitchVary = 0.06,\n\t\trange = 420,\n\t},\n\n\t-- === Placement ========================================================\n\t-- A block landing: the material's own tap, with a low thump under it for\n\t-- weight. This is the sound the player hears most while building.\n\t[\"place.stone\"] = {\n\t\tid = Palette.Tap,\n\t\tvolume = 0.5,\n\t\tpitch = 0.55,\n\t\tpitchVary = 0.07,\n\t\tlayer = { id = Palette.Thump, volume = 0.16, pitch = 2.4 },\n\t},\n\t[\"place.soft\"] = { id = Palette.Tap, volume = 0.42, pitch = 0.95, pitchVary = 0.09 },\n\t[\"place.sand\"] = { id = Palette.Granular, volume = 0.34, pitch = 1.35, pitchVary = 0.1 },\n\t[\"place.wood\"] = {\n\t\tid = Palette.Tap,\n\t\tvolume = 0.46,\n\t\tpitch = 1.15,\n\t\tpitchVary = 0.07,\n\t\tlayer = { id = Palette.Thump, volume = 0.12, pitch = 2.8 },\n\t},\n\t[\"place.ore\"] = { id = Palette.Tap, volume = 0.5, pitch = 0.45, pitchVary = 0.06 },\n\t[\"place.station\"] = {\n\t\tid = Palette.Clack,\n\t\tvolume = 0.45,\n\t\tpitch = 0.75,\n\t\tpitchVary = 0.05,\n\t\tlayer = { id = Palette.Tap, volume = 0.3, pitch = 0.9 },\n\t},\n\n\t-- === Mining: the tick while you are chipping away ======================\n\t-- Quiet and heavily jittered; several of these fire per block.\n\t[\"mine.hit.stone\"] = { id = Palette.Tap, volume = 0.18, pitch = 0.5, pitchVary = 0.14, throttle = 0.05 },\n\t[\"mine.hit.soft\"] = { id = Palette.Tap, volume = 0.15, pitch = 0.85, pitchVary = 0.16, throttle = 0.05 },\n\t[\"mine.hit.sand\"] = { id = Palette.Granular, volume = 0.14, pitch = 1.5, pitchVary = 0.18, throttle = 0.05 },\n\t[\"mine.hit.wood\"] = { id = Palette.Tap, volume = 0.18, pitch = 1.1, pitchVary = 0.13, throttle = 0.05 },\n\t[\"mine.hit.ore\"] = { id = Palette.Tap, volume = 0.22, pitch = 0.4, pitchVary = 0.1, throttle = 0.05 },\n\n\t-- === Mining: the block giving way =====================================\n\t-- Each is a crumble plus the material's own colour on top.\n\t[\"mine.break.stone\"] = {\n\t\tid = Palette.Crumble,\n\t\tvolume = 0.42,\n\t\tpitch = 1.45,\n\t\tpitchVary = 0.08,\n\t\tlayer = { id = Palette.Tap, volume = 0.3, pitch = 0.5 },\n\t},\n\t[\"mine.break.soft\"] = {\n\t\tid = Palette.Crumble,\n\t\tvolume = 0.36,\n\t\tpitch = 1.85,\n\t\tpitchVary = 0.09,\n\t\tlayer = { id = Palette.Tap, volume = 0.2, pitch = 0.85 },\n\t},\n\t[\"mine.break.sand\"] = {\n\t\tid = Palette.Granular,\n\t\tvolume = 0.34,\n\t\tpitch = 1.0,\n\t\tpitchVary = 0.09,\n\t\tlayer = { id = Palette.Soft, volume = 0.18, pitch = 1.6 },\n\t},\n\t[\"mine.break.wood\"] = {\n\t\tid = Palette.Crumble,\n\t\tvolume = 0.42,\n\t\tpitch = 1.65,\n\t\tpitchVary = 0.08,\n\t\tlayer = { id = Palette.Tap, volume = 0.26, pitch = 1.1 },\n\t},\n\t-- Ore is the payoff, so it gets the chime the crafting success uses.\n\t[\"mine.break.ore\"] = {\n\t\tid = Palette.Crumble,\n\t\tvolume = 0.4,\n\t\tpitch = 1.3,\n\t\tpitchVary = 0.06,\n\t\tlayer = { id = Palette.Chime, volume = 0.3, pitch = 1.15 },\n\t},\n}\n\n-- ---------------------------------------------------------------------------\n-- Material groups\n-- ---------------------------------------------------------------------------\n\n-- Curated group-owned imports. Keep the existing gameplay keys so every UI\n-- consumer picks up the new assets without changing its event handlers.\nlocal Imported = require(script.Parent:WaitForChild(\"DownloadedSounds\"))\nlocal imports = {\n    [\"ui.hover\"] = {\"ui_hover\", .12, .05},\n    [\"ui.click\"] = {\"ui_click\", .4},\n    [\"ui.tab\"] = {\"ui_tab\", .25},\n    [\"ui.open\"] = {\"ui_open\", .32},\n    [\"ui.close\"] = {\"ui_close\", .28},\n    [\"ui.denied\"] = {\"ui_denied\", .3, .12},\n    [\"ui.notify\"] = {\"ui_notify\", .3},\n    [\"craft.success\"] = {\"craft_success\", .4},\n    [\"craft.fail\"] = {\"ui_denied\", .3},\n    [\"loot.pickup\"] = {\"loot_pickup\", .3, .08},\n    [\"tool.swing\"] = {\"ability_whoosh\", .2, .08},\n    [\"ability.sacredrain.portal\"] = {\"ability_portal\", .45},\n    [\"ability.sacredrain.impact\"] = {\"ability_impact_heavy\", .55},\n    [\"ability.eclipse.charge\"] = {\"ability_charge\", .5},\n    [\"ability.eclipse.burst\"] = {\"ability_impact_heavy\", .8},\n    [\"ability.eclipse.aftershock\"] = {\"ability_impact_heavy\", .4},\n}\nfor key, entry in pairs(imports) do\n    SoundConfig.Sounds[key] = {id = Imported[entry[1]], volume = entry[2], throttle = entry[3],\n        pitch = 1, pitchVary = .025, lifetime = if entry[1] == \"ability_charge\" then 15 else 7,\n        range = if string.sub(key, 1, 8) == \"ability.\" then 300 else 90}\nend\nfor key, id in pairs(Imported) do\n    if string.sub(key, 1, 8) == \"ability_\" then\n        SoundConfig.Sounds[\"ability.\" .. string.sub(key, 9)] = {id = id, volume = .45, pitch = 1, range = 180,\n            lifetime = if key == \"ability_charge\" then 15 else 7}\n    end\nend\n\nSoundConfig.DefaultGroup = \"stone\"\n\n-- Exact block name -> group.\nSoundConfig.BlockGroups = {\n\tGrass = \"soft\",\n\tDirt = \"soft\",\n\tCorruptedDirt = \"soft\",\n\tCrimsonDirt = \"soft\",\n\tHallowedDirt = \"soft\",\n\n\tSand = \"sand\",\n\tSnow = \"sand\",\n\n\tStone = \"stone\",\n\tSandstone = \"stone\",\n\tCobblestone = \"stone\",\n\tStoneBricks = \"stone\",\n\tMagmaBrick = \"stone\",\n\tCorruptedStone = \"stone\",\n\tCrimsonStone = \"stone\",\n\tHallowedStone = \"stone\",\n\tBedrock = \"stone\",\n\n\tWoodPlank = \"wood\",\n\tWood = \"wood\",\n\n\tWater = \"sand\",\n}\n\n-- Fallbacks applied when the exact name is unknown. Checked in order.\nSoundConfig.SuffixGroups = {\n\t{ suffix = \"Ore\", group = \"ore\" },\n\t{ suffix = \"Ingot\", group = \"ore\" },\n\t{ suffix = \"Stone\", group = \"stone\" },\n\t{ suffix = \"Brick\", group = \"stone\" },\n\t{ suffix = \"Bricks\", group = \"stone\" },\n\t{ suffix = \"Dirt\", group = \"soft\" },\n\t{ suffix = \"Plank\", group = \"wood\" },\n}\n\n--[[\n\tMaterial group for a block name. Never returns nil.\n]]\nfunction SoundConfig.groupFor(blockName)\n\tif type(blockName) ~= \"string\" or blockName == \"\" then\n\t\treturn SoundConfig.DefaultGroup\n\tend\n\n\tlocal exact = SoundConfig.BlockGroups[blockName]\n\tif exact then\n\t\treturn exact\n\tend\n\n\tfor _, rule in ipairs(SoundConfig.SuffixGroups) do\n\t\tif string.sub(blockName, -#rule.suffix) == rule.suffix then\n\t\t\treturn rule.group\n\t\tend\n\tend\n\n\treturn SoundConfig.DefaultGroup\nend\n\n--[[\n\tConvenience: the full sound key for an action on a block.\n\t  SoundConfig.keyFor(\"mine.hit\", \"CoalOre\") -> \"mine.hit.ore\"\n]]\nfunction SoundConfig.keyFor(prefix, blockName)\n\treturn prefix .. \".\" .. SoundConfig.groupFor(blockName)\nend\n\nreturn SoundConfig\n"},
{path="ReplicatedStorage/Shared/Audio/Ambience",class="ModuleScript",source="-- Client ambient bed. Weather is consumed from attributes; this does not create weather.\n-- Optional spatial loops: tag a BasePart/Attachment \"BlockboundAmbience\" and set\n-- AmbienceKey to \"fire\", \"waterfall\", etc. Untagging or removing it stops its loop.\nlocal Players = game:GetService(\"Players\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal RunService = game:GetService(\"RunService\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal CollectionService = game:GetService(\"CollectionService\")\nlocal Assets = require(script.Parent:WaitForChild(\"DownloadedSounds\"))\nlocal Sounds = require(script.Parent:WaitForChild(\"Sounds\"))\nlocal Ambience = {}\nlocal started = false\nlocal beds, spatial = {}, {}\n-- These two uploads failed client approval checks on 2026-11-01. Do not try\n-- to play the waterfall until approved; use the working rain quietly instead.\nlocal unavailable = {waterfall = true}\nlocal overrides = {rain_light = Assets.ambience_rain_heavy}\nlocal levels = {wind = .08, night = .16, sea = .14, snow = .12,\n    rain_light = .2, rain_heavy = .22, thunderstorm = .18}\n\nlocal function desired()\n    local player = Players.LocalPlayer\n    local character = player.Character\n    local head = character and character:FindFirstChild(\"Head\")\n    if not head then return nil end\n    -- Suppress outdoor beds under a roof, including caves.\n    local params = RaycastParams.new()\n    params.FilterType = Enum.RaycastFilterType.Exclude\n    local exclude = {}\n    for _, p in ipairs(Players:GetPlayers()) do\n        if p.Character then table.insert(exclude, p.Character) end\n    end\n    params.FilterDescendantsInstances = exclude\n    params.RespectCanCollide = true\n    if workspace:Raycast(head.Position, Vector3.new(0, 100, 0), params) then return nil end\n    local weather = workspace:GetAttribute(\"Weather\")\n    if type(weather) == \"string\" then weather = string.lower(weather) end\n    if weather == \"thunderstorm\" then return \"thunderstorm\" end\n    if weather == \"storm\" or weather == \"heavyrain\" then return \"rain_heavy\" end\n    if weather == \"rain\" or workspace:GetAttribute(\"Raining\") == true then return \"rain_light\" end\n    local biome = player:GetAttribute(\"Biome\")\n    if biome == \"Snow\" then return \"snow\" end\n    if biome == \"Ocean\" or biome == \"Beach\" then return \"sea\" end\n    if Lighting.ClockTime < 6 or Lighting.ClockTime >= 18 then return \"night\" end\n    return \"wind\"\nend\n\nlocal function spatialLoop(host)\n    if spatial[host] or not (host:IsA(\"BasePart\") or host:IsA(\"Attachment\")) then return end\n    local key = host:GetAttribute(\"AmbienceKey\")\n    if type(key) ~= \"string\" then return end\n    local id = Assets[\"ambience_\" .. key]\n    if not id or unavailable[key] then return end\n    local sound = Instance.new(\"Sound\")\n    sound.Name, sound.SoundId, sound.Looped, sound.Volume = \"AmbientLoop\", id, true, 0\n    sound.RollOffMinDistance, sound.RollOffMaxDistance = 8, 80\n    sound.Parent = host\n    spatial[host] = sound\n    sound:Play()\nend\n\nfunction Ambience.start()\n    if started or not RunService:IsClient() then return end\n    started = true\n    local folder = Instance.new(\"Folder\")\n    folder.Name, folder.Parent = \"WorldAmbience\", SoundService\n    for _, host in ipairs(CollectionService:GetTagged(\"BlockboundAmbience\")) do spatialLoop(host) end\n    CollectionService:GetInstanceAddedSignal(\"BlockboundAmbience\"):Connect(spatialLoop)\n    CollectionService:GetInstanceRemovedSignal(\"BlockboundAmbience\"):Connect(function(host)\n        local sound = spatial[host]\n        if sound then sound:Destroy(); spatial[host] = nil end\n    end)\n    task.spawn(function()\n        while started do\n            local key = desired()\n            local master = math.clamp(Sounds.MasterVolume, 0, 1)\n            if key and master > 0 and not beds[key] then\n                local sound = Instance.new(\"Sound\")\n                sound.Name, sound.SoundId = key, overrides[key] or Assets[\"ambience_\" .. key]\n                sound.Looped, sound.Volume, sound.Parent = true, 0, folder\n                beds[key] = sound\n            end\n            for name, sound in pairs(beds) do\n                local target = if name == key then levels[name] * master else 0\n                sound.Volume += (target - sound.Volume) * .18\n                if master == 0 then sound.Volume = 0 end\n                if target > 0 then\n                    if not sound.IsPlaying then sound:Resume() end\n                elseif sound.Volume < .001 then\n                    sound.Volume = 0\n                    sound:Pause()\n                end\n            end\n            for host, sound in pairs(spatial) do\n                if not host:IsDescendantOf(workspace) then\n                    sound:Destroy(); spatial[host] = nil\n                else\n                    sound.Volume = .25 * master\n                    if master == 0 then sound:Pause()\n                    elseif not sound.IsPlaying then sound:Resume() end\n                end\n            end\n            task.wait(.25)\n        end\n    end)\nend\n\nreturn Ambience\n"},
{path="StarterPlayer/StarterPlayerScripts/SoundHandler",class="LocalScript",source="--[[\n\tSoundHandler\n\n\tStarts the background playlist.\n\n\tThe playlist, the fades and the Sound instance all live in\n\tShared.Audio.Music, which is the only thing that writes Sound.Volume - the\n\tsettings panel's slider asks that module too, so the two cannot disagree.\n\tThis\n\tscript exists because starting the music is a decision about WHEN, and that\n\tbelongs to StarterPlayerScripts rather than to a module somebody might\n\trequire for an unrelated reason.\n\n\tThe first track arrives a few seconds after joining, then the soundtrack\n\truns itself: tracks with silence between them, and boss themes when a fight\n\tstarts. See Shared.Audio.Music.\n]]\n\nlocal ReplicatedStorage = game:GetService(\"ReplicatedStorage\")\n\nlocal Music = require(\n\tReplicatedStorage:WaitForChild(\"Shared\"):WaitForChild(\"Audio\"):WaitForChild(\"Music\")\n)\n\nMusic.start()\n\nlocal Ambience = require(ReplicatedStorage.Shared.Audio:WaitForChild(\"Ambience\"))\nAmbience.start()\n"},
{path="ReplicatedStorage/Shared/Audio/Sounds",class="ModuleScript",source="--[[\n\tSounds\n\n\tPlays the things SoundConfig describes, without letting them pile up.\n\n\t\tSounds.play(\"ui.click\")                     -- 2D, at the listener\n\t\tSounds.playAt(\"mine.break.stone\", position) -- 3D, in the world\n\n\tThree things keep it pleasant: every play jitters PlaybackSpeed within the\n\tsound's `pitchVary` (identical repetition is what the ear notices), a key\n\twith a `throttle` refuses to replay inside that window, and 2D sounds reuse\n\tone instance per key rather than allocating per play.\n\n\tCalling it on the server is a no-op rather than an error, so shared code can\n\tcall it without guarding.\n]]\n\nlocal RunService = game:GetService(\"RunService\")\nlocal SoundService = game:GetService(\"SoundService\")\nlocal Debris = game:GetService(\"Debris\")\n\nlocal SoundConfig = require(script.Parent:WaitForChild(\"SoundConfig\"))\n\nlocal Sounds = {}\n\nlocal IS_CLIENT = RunService:IsClient()\n\n-- Master volume, so everything can be ducked at once later.\nSounds.MasterVolume = 1\n\nlocal pool = {} -- key -> Sound, for non-positional playback\nlocal lastPlayed = {} -- key -> os.clock() of the previous play\nlocal warned = {} -- key -> true, so an unknown key complains only once\n\nlocal container = nil\n\nlocal function getContainer()\n\tif container then\n\t\treturn container\n\tend\n\n\tcontainer = SoundService:FindFirstChild(\"GameSounds\")\n\tif not container then\n\t\tcontainer = Instance.new(\"Folder\")\n\t\tcontainer.Name = \"GameSounds\"\n\t\tcontainer.Parent = SoundService\n\tend\n\n\treturn container\nend\n\n-- Complains once for a typo rather than on every frame that hits it.\nlocal function definitionFor(key)\n\tlocal definition = SoundConfig.Sounds[key]\n\tif definition then\n\t\treturn definition\n\tend\n\n\tif not warned[key] then\n\t\twarned[key] = true\n\t\twarn(string.format(\"[Sounds] no sound configured for '%s'\", tostring(key)))\n\tend\n\n\treturn nil\nend\n\nlocal function isThrottled(key, definition)\n\tlocal gap = definition.throttle\n\tif not gap then\n\t\treturn false\n\tend\n\n\tlocal now = os.clock()\n\tlocal previous = lastPlayed[key]\n\tif previous and now - previous < gap then\n\t\treturn true\n\tend\n\n\tlastPlayed[key] = now\n\treturn false\nend\n\nlocal function randomPitch(definition)\n\tlocal vary = definition.pitchVary or 0\n\tlocal base = definition.pitch or 1\n\tif vary <= 0 then\n\t\treturn base\n\tend\n\treturn base + (math.random() * 2 - 1) * vary\nend\n\n-- A definition's optional second layer. Layering a thud under a crack is most\n-- of what makes a placeholder sound designed rather than stock. Layers never\n-- throttle or pool; they live and die with the play that triggered them.\nlocal function playLayer(layer, position, volumeScale)\n\tif not layer then\n\t\treturn\n\tend\n\n\tlocal sound = Instance.new(\"Sound\")\n\tsound.SoundId = layer.id\n\tsound.Volume = (layer.volume or 0.3) * Sounds.MasterVolume * (volumeScale or 1)\n\tsound.PlaybackSpeed = randomPitch(layer)\n\n\tif position then\n\t\tlocal anchor = Instance.new(\"Part\")\n\t\tanchor.Anchored = true\n\t\tanchor.CanCollide = false\n\t\tanchor.CanQuery = false\n\t\tanchor.CanTouch = false\n\t\tanchor.Transparency = 1\n\t\tanchor.Size = Vector3.one\n\t\tanchor.CFrame = CFrame.new(position)\n\t\tanchor.Parent = workspace\n\n\t\tsound.RollOffMaxDistance = layer.range or 90\n\t\tsound.Parent = anchor\n\t\tsound:Play()\n\t\tDebris:AddItem(anchor, 4)\n\telse\n\t\tsound.Parent = getContainer()\n\t\tsound:Play()\n\t\tDebris:AddItem(sound, 4)\n\tend\nend\n\n-- Non-positional. One Sound per key: replaying restarts it, which is what you\n-- want for UI anyway.\nfunction Sounds.play(key, volumeScale)\n\tif not IS_CLIENT then\n\t\treturn\n\tend\n\n\tlocal definition = definitionFor(key)\n\tif not definition or isThrottled(key, definition) then\n\t\treturn\n\tend\n\n\tlocal sound = pool[key]\n\tif not sound then\n\t\tsound = Instance.new(\"Sound\")\n\t\tsound.Name = key\n\t\tsound.SoundId = definition.id\n\t\tsound.Parent = getContainer()\n\t\tpool[key] = sound\n\tend\n\n\tsound.Volume = (definition.volume or 0.5) * Sounds.MasterVolume * (volumeScale or 1)\n\tsound.PlaybackSpeed = randomPitch(definition)\n\tsound.TimePosition = 0\n\tsound:Play()\n\n\tplayLayer(definition.layer, nil, volumeScale)\nend\n\n-- Positional, on a throwaway part so it attenuates with distance. Overlapping\n-- plays are fine: two blocks breaking should sound like two blocks breaking.\nfunction Sounds.playAt(key, position, volumeScale)\n\tif not IS_CLIENT then\n\t\treturn\n\tend\n\n\tlocal definition = definitionFor(key)\n\tif not definition or isThrottled(key, definition) then\n\t\treturn\n\tend\n\n\tlocal anchor = Instance.new(\"Part\")\n\tanchor.Name = \"SoundAnchor\"\n\tanchor.Anchored = true\n\tanchor.CanCollide = false\n\tanchor.CanQuery = false\n\tanchor.CanTouch = false\n\tanchor.Transparency = 1\n\tanchor.Size = Vector3.one\n\tanchor.CFrame = CFrame.new(position)\n\tanchor.Parent = workspace\n\n\tlocal sound = Instance.new(\"Sound\")\n\tsound.SoundId = definition.id\n\tsound.Volume = (definition.volume or 0.5) * Sounds.MasterVolume * (volumeScale or 1)\n\tsound.PlaybackSpeed = randomPitch(definition)\n\tsound.RollOffMaxDistance = definition.range or 90\n\tsound.Parent = anchor\n\tsound:Play()\n\n\tsound.Ended:Once(function() anchor:Destroy() end)\n\tDebris:AddItem(anchor, definition.lifetime or 4)\n\n\tplayLayer(definition.layer, position, volumeScale)\nend\n\n-- The right variant of an action for a block's material:\n--   Sounds.playBlock(\"mine.break\", \"CoalOre\", position)\nfunction Sounds.playBlock(prefix, blockName, position, volumeScale)\n\tlocal key = SoundConfig.keyFor(prefix, blockName)\n\n\tif position then\n\t\tSounds.playAt(key, position, volumeScale)\n\telse\n\t\tSounds.play(key, volumeScale)\n\tend\nend\n\nreturn Sounds\n"},
}
local errors = {}
for _, def in ipairs(definitions) do
    local fn, err = loadstring(def.source, def.path)
    if not fn then table.insert(errors, {path=def.path,error=err}) end
end
if #errors > 0 then return {errors=errors} end
local updated = {}
for _, def in ipairs(definitions) do
    local bits = string.split(def.path, "/")
    local parent = game:GetService(table.remove(bits, 1))
    local name = table.remove(bits)
    for _, bit in ipairs(bits) do parent = parent:FindFirstChild(bit); assert(parent, def.path) end
    local target = parent:FindFirstChild(name)
    if not target then target=Instance.new(def.class);target.Name=name;target.Parent=parent end
    assert(target.ClassName == def.class, def.path)
    target.Source = def.source
    table.insert(updated, def.path)
end
return {updated=updated, syntaxErrors=errors}